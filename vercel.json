{
  "version": 2,
  "name": "openattend-vesit",
  "cleanUrls": true,
  "routes": [
    {
      "src": "/sw.js",
      "dest": "/sw.js",
      "headers": { "cache-control": "public, max-age=0, must-revalidate" }
    },
    {
      "src": "/manifest.json",
      "dest": "/manifest.json"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}

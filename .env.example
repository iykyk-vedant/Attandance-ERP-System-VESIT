# OpenAttend Environment Variables Template
# Copy this file to .env for local development

# Database Connection
# Local Docker postgres: "postgresql://openattend:openattend_secure_password@localhost:5432/openattend?schema=public"
# Supabase PostgreSQL: "postgres://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"
DATABASE_URL="postgresql://openattend:openattend_secure_password@localhost:5432/openattend"

# Authentication & Security
JWT_ACCESS_SECRET="openattend_super_secret_access_jwt_key_32chars_long"
JWT_ACCESS_EXPIRY_MS=900000
ALLOWED_EMAIL_DOMAINS="ves.ac.in"

# Application Port
PORT=3000
LOG_LEVEL="info"

# v0.dev Integration
V0_API_KEY="your_v0_api_key_here"

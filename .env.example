# OpenAttend Environment Variables Template
# Copy this file to .env for local development

# Database Connection (Supabase PostgreSQL)
# Replace placeholders with your actual Supabase credentials
DATABASE_URL="postgres://postgres.[YOUR-PROJECT-REF]:[YOUR-DATABASE-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# Supabase Client Credentials (Placeholders)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key_here"

# Authentication & JWT Secrets
JWT_ACCESS_SECRET="your_super_secret_access_jwt_key_32chars"
JWT_REFRESH_SECRET="your_super_secret_refresh_jwt_key_32chars"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Google Integration (Read-Only Service Account)
GOOGLE_SERVICE_ACCOUNT_JSON=""
ALLOWED_EMAIL_DOMAINS="ves.ac.in"

# Sync Engine Configuration
SYNC_DEFAULT_CRON="*/15 * * * *"
SYNC_MAX_RETRIES=5
SYNC_BACKOFF_BASE_MS=2000

# Application Setup
PORT=3000
NODE_ENV="development"
LOG_LEVEL="info"

# Frontend Configuration
VITE_API_BASE_URL="http://localhost:3000/api/v1"

<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>OpenAttend — Live Companion Platform for VESIT Attendance</title>
  <!-- PWA & Mobile Web App Settings -->
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#2F6F5E">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="OpenAttend">
  <link rel="icon" type="image/png" sizes="192x192" href="assets/icon.png">
  <link rel="apple-touch-icon" href="assets/icon.png">
  <style>
    :root[data-theme="light"] {
      --bg-base:        #FAFAF8;
      --bg-surface:     #FFFFFF;
      --bg-surface-2:   #F2F1EC;
      --border-subtle:  #E7E5DE;
      --border-strong:  #D3D0C6;
      --text-primary:   #1C1B18;
      --text-secondary: #6B6A62;
      --text-tertiary:  #A3A199;
      --accent:         #2F6F5E;
      --accent-dim:     #E4EFEB;
      --state-safe:     #2F9E6E;
      --state-risk:     #D64545;
      --state-warn:     #C98A1E;
      --state-neutral:  #8B897F;
      --shadow-sm:      0 2px 8px rgba(28, 27, 24, 0.04);
      --shadow-md:      0 4px 16px rgba(28, 27, 24, 0.08);
    }

    :root[data-theme="dark"] {
      --bg-base:        #14161A;
      --bg-surface:     #1B1E23;
      --bg-surface-2:   #22262C;
      --border-subtle:  #2B3038;
      --border-strong:  #3A424C;
      --text-primary:   #ECEBE6;
      --text-secondary: #9B9A92;
      --text-tertiary:  #6B6A62;
      --accent:         #5FBFA6;
      --accent-dim:     #1E2E29;
      --state-safe:     #4ADE94;
      --state-risk:     #F27272;
      --state-warn:     #E0AA46;
      --state-neutral:  #6E7178;
      --shadow-sm:      0 2px 8px rgba(0, 0, 0, 0.2);
      --shadow-md:      0 4px 16px rgba(0, 0, 0, 0.4);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    
    body {
      font-family: 'Inter', -apple-system, sans-serif;
      font-size: 14px;
      background: var(--bg-base);
      color: var(--text-primary);
      min-height: 100vh;
      display: flex;
      transition: background 0.2s ease, color 0.2s ease;
    }

    .font-mono { font-family: 'IBM Plex Mono', monospace; }

    /* App Layout */
    .app-shell {
      display: flex;
      width: 100vw;
      min-height: 100vh;
    }

    /* Left Sidebar */
    aside.sidebar {
      width: 240px;
      background: var(--bg-surface);
      border-right: 1px solid var(--border-subtle);
      display: flex;
      flex-direction: column;
      padding: 1.25rem 1rem;
      position: fixed;
      top: 0;
      bottom: 0;
      left: 0;
      z-index: 50;
      transition: width 0.2s ease;
    }

    .brand-header {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.5rem 0.5rem 1.25rem 0.5rem;
      border-bottom: 1px solid var(--border-subtle);
      user-select: none;
    }

    .brand-icon-wrap {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #14161A;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
      flex-shrink: 0;
      border: 1px solid var(--border-subtle);
      transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .brand-icon-wrap:hover {
      transform: scale(1.06) rotate(2deg);
    }

    .brand-icon-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .brand-text-wrap {
      display: flex;
      flex-direction: column;
      gap: 1px;
      min-width: 0;
    }

    .brand-title {
      font-weight: 700;
      font-size: 1.15rem;
      letter-spacing: -0.2px;
      color: var(--text-primary);
      line-height: 1.2;
    }

    .brand-subtitle {
      font-size: 10px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.75px;
      color: var(--accent);
      line-height: 1;
    }

    .nav-section {
      margin-top: 1.25rem;
    }

    .nav-section-title {
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      color: var(--text-tertiary);
      padding: 0 0.5rem 0.5rem 0.5rem;
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.6rem 0.75rem;
      border-radius: 8px;
      color: var(--text-secondary);
      text-decoration: none;
      font-weight: 500;
      cursor: pointer;
      margin-bottom: 2px;
      transition: all 0.15s ease;
    }

    .nav-item:hover {
      background: var(--bg-surface-2);
      color: var(--text-primary);
    }

    .nav-item.active {
      background: var(--accent-dim);
      color: var(--accent);
      font-weight: 600;
      border-left: 3px solid var(--accent);
    }

    .sidebar-footer {
      margin-top: auto;
      padding-top: 1rem;
      border-top: 1px solid var(--border-subtle);
    }

    .role-switcher {
      display: flex;
      background: var(--bg-surface-2);
      border-radius: 8px;
      padding: 3px;
      margin-bottom: 0.75rem;
    }

    .role-btn {
      flex: 1;
      padding: 0.4rem 0.5rem;
      font-size: 12px;
      font-weight: 600;
      border: none;
      background: transparent;
      color: var(--text-secondary);
      border-radius: 6px;
      cursor: pointer;
      text-align: center;
      transition: all 0.15s ease;
    }

    .role-btn.active {
      background: var(--bg-surface);
      color: var(--text-primary);
      box-shadow: var(--shadow-sm);
    }

    /* Main Area */
    main.main-content {
      margin-left: 240px;
      flex: 1;
      display: flex;
      flex-direction: column;
      min-width: 0;
    }

    /* Top Bar */
    header.topbar {
      height: 60px;
      background: var(--bg-surface);
      border-bottom: 1px solid var(--border-subtle);
      padding: 0 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 40;
    }

    .topbar-left {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .topbar-logo-mobile {
      display: none;
      width: 32px;
      height: 32px;
      border-radius: 8px;
      object-fit: cover;
      border: 1px solid var(--border-subtle);
      box-shadow: var(--shadow-sm);
    }

    .page-title {
      font-size: 1.15rem;
      font-weight: 600;
    }

    .topbar-right {
      display: flex;
      align-items: center;
      gap: 1.25rem;
    }

    /* SyncPulse Indicator */
    .sync-pulse-bar {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 13px;
      color: var(--text-secondary);
      background: var(--bg-surface-2);
      padding: 0.35rem 0.85rem;
      border-radius: 999px;
      border: 1px solid var(--border-subtle);
    }

    .pulse-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--state-safe);
      animation: pulse-glow 2s infinite ease-in-out;
    }

    @keyframes pulse-glow {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.4; transform: scale(0.85); }
    }

    .theme-toggle-btn {
      background: var(--bg-surface-2);
      border: 1px solid var(--border-subtle);
      color: var(--text-primary);
      padding: 0.35rem 0.75rem;
      border-radius: 8px;
      font-size: 12px;
      font-weight: 500;
      cursor: pointer;
    }

    /* View Container */
    .content-viewport {
      padding: 2rem;
      max-width: 1140px;
      width: 100%;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 1.75rem;
    }

    .view-pane {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      width: 100%;
    }

    /* Signature Components */
    /* 1. Percentage Ring Hero */
    .hero-ring-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: 20px;
      padding: 2rem;
      display: flex;
      align-items: center;
      gap: 2.5rem;
      box-shadow: var(--shadow-sm);
    }

    .ring-wrapper {
      position: relative;
      width: 140px;
      height: 140px;
    }

    .ring-center-text {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;

    }

    .ring-center-val {
      font-size: 40px;
      font-weight: 700;
      line-height: 1;
      letter-spacing: -1px;
    }

    .ring-center-lbl {
      font-size: 11px;
      color: var(--text-tertiary);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-top: 4px;
    }

    .hero-metrics {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      flex: 1;
    }

    .student-info-row {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .student-name {
      font-size: 1.5rem;
      font-weight: 700;
    }

    .badge-chip {
      font-size: 12px;
      font-family: 'IBM Plex Mono', monospace;
      background: var(--bg-surface-2);
      color: var(--text-secondary);
      padding: 0.2rem 0.6rem;
      border-radius: 6px;
      border: 1px solid var(--border-subtle);
    }

    .stats-kpi-grid {
      display: flex;
      gap: 2.5rem;
      margin-top: 0.5rem;
    }

    .kpi-item {
      display: flex;
      flex-direction: column;
    }

    .kpi-num {
      font-size: 1.25rem;
      font-weight: 700;
    }

    .kpi-label {
      font-size: 12px;
      color: var(--text-secondary);
    }

    /* 2. Predictor Callout */
    .predictor-callout-card {
      background: var(--accent-dim);
      border: 1px solid var(--accent);
      border-radius: 12px;
      padding: 1.25rem 1.5rem;
      color: var(--text-primary);
    }

    .predictor-sentence {
      font-size: 1.1rem;
      font-weight: 500;
      line-height: 1.5;
    }

    .predictor-num {
      color: var(--accent);
      font-weight: 700;
    }

    .predictor-formula-toggle {
      font-size: 12px;
      color: var(--text-secondary);
      cursor: pointer;
      margin-top: 0.75rem;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      text-decoration: underline;
    }

    .predictor-formula-panel {
      margin-top: 0.75rem;
      padding: 0.85rem 1rem;
      background: var(--bg-surface);
      border-radius: 8px;
      border: 1px solid var(--border-subtle);
      font-size: 12px;
      color: var(--text-secondary);
    }

    /* 3. RollCallRow Component */
    .roll-call-stack {
      display: flex;
      flex-direction: column;
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: 12px;
      overflow: hidden;
    }

    .roll-call-row {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 0.85rem 1.25rem;
      border-bottom: 1px solid var(--border-subtle);
      transition: background 0.15s ease;
    }

    .roll-call-row:last-child {
      border-bottom: none;
    }

    .roll-call-row:hover {
      background: var(--bg-surface-2);
    }

    .rc-date {
      width: 100px;
      font-size: 13px;
      color: var(--text-secondary);
    }

    .rc-subject {
      flex: 1;
      font-weight: 600;
    }

    .rc-status {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      width: 110px;
    }

    .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
    }

    .dot-safe { background: var(--state-safe); }
    .dot-risk { background: var(--state-risk); }
    .dot-warn { background: var(--state-warn); }
    .dot-neutral { background: var(--state-neutral); }

    .rc-detail {
      color: var(--text-tertiary);
      font-size: 13px;
    }

    /* Subject Cards Grid */
    .cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 1.25rem;
    }

    .subject-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: 12px;
      padding: 1.25rem;
      display: flex;
      flex-direction: column;
      gap: 1rem;
      position: relative;
    }

    .subject-card.risk-border {
      border-left: 3px solid var(--state-risk);
    }

    .subject-card.safe-border {
      border-left: 3px solid var(--state-safe);
    }

    .sc-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
    }

    .sc-code {
      font-size: 12px;
      color: var(--text-tertiary);
    }

    .sc-title {
      font-size: 1rem;
      font-weight: 600;
      margin-top: 2px;
    }

    .sc-pct {
      font-size: 1.1rem;
      font-weight: 700;
    }

    .sc-progress-bar {
      height: 6px;
      background: var(--bg-surface-2);
      border-radius: 999px;
      overflow: hidden;
    }

    .sc-progress-fill {
      height: 100%;
      border-radius: 999px;
    }

    .sc-footer {
      display: flex;
      justify-content: space-between;
      font-size: 12px;
      color: var(--text-secondary);
    }

    /* Forms & Admin Component Styles */
    .admin-hero-banner {
      width: 100%;
      max-height: 180px;
      border-radius: 12px;
      overflow: hidden;
      margin-bottom: 1.5rem;
      border: 1px solid var(--border-subtle);
      box-shadow: var(--shadow-sm);
    }

    .admin-banner-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .form-panel {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: 12px;
      padding: 1.75rem;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }

    .form-label {
      font-size: 13px;
      font-weight: 600;
      color: var(--text-primary);
    }

    .form-hint {
      font-size: 12px;
      color: var(--text-tertiary);
    }

    .form-input, .form-select {
      background: var(--bg-base);
      border: 1px solid var(--border-strong);
      border-radius: 8px;
      padding: 0.65rem 0.85rem;
      font-size: 14px;
      color: var(--text-primary);
      outline: none;
      transition: border-color 0.15s ease;
    }

    .form-input:focus, .form-select:focus {
      border-color: var(--accent);
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 0.65rem 1.25rem;
      font-size: 14px;
      font-weight: 600;
      border-radius: 8px;
      border: none;
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .btn-primary {
      background: var(--accent);
      color: #FFFFFF;
    }

    .btn-primary:hover {
      opacity: 0.9;
    }

    .btn-secondary {
      background: var(--bg-surface-2);
      border: 1px solid var(--border-subtle);
      color: var(--text-primary);
    }

    .btn-secondary:hover {
      background: var(--border-subtle);
    }

    .btn-danger {
      background: var(--state-risk);
      color: #FFFFFF;
    }

    /* Live Column Role Mapping Preview Table */
    .column-preview-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 1rem;
    }

    .column-preview-table th {
      background: var(--bg-surface-2);
      padding: 0.75rem;
      border: 1px solid var(--border-subtle);
    }

    .column-preview-table td {
      padding: 0.75rem;
      border: 1px solid var(--border-subtle);
      font-size: 13px;
    }

    .chips-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-top: 0.5rem;
    }

    .tab-chip {
      background: var(--bg-surface-2);
      border: 1px solid var(--border-subtle);
      padding: 0.3rem 0.75rem;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 500;
    }

    /* Tab navigation sub-bar */
    .sub-tabs {
      display: flex;
      gap: 1rem;
      border-bottom: 1px solid var(--border-subtle);
      padding-bottom: 0.5rem;
    }

    .sub-tab-btn {
      background: none;
      border: none;
      font-size: 14px;
      font-weight: 500;
      color: var(--text-secondary);
      padding: 0.4rem 0.6rem;
      cursor: pointer;
      border-bottom: 2px solid transparent;
    }

    .sub-tab-btn.active {
      color: var(--accent);
      border-bottom-color: var(--accent);
      font-weight: 600;
    }

    /* Glassmorphic Login Modal & Auth Overlay */
    .auth-overlay {
      position: fixed;
      inset: 0;
      background: rgba(15, 17, 21, 0.78);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      z-index: 1000;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
      opacity: 1;
      transition: opacity 0.25s ease, visibility 0.25s ease;
    }

    .auth-overlay.hidden {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    .auth-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-strong);
      border-radius: 24px;
      width: 100%;
      max-width: 440px;
      padding: 2.25rem;
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.35);
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      animation: auth-card-pop 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @keyframes auth-card-pop {
      from { opacity: 0; transform: scale(0.94) translateY(12px); }
      to { opacity: 1; transform: scale(1) translateY(0); }
    }

    .auth-header {
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.4rem;
    }

    .auth-brand-logo-wrap {
      width: 120px;
      height: 120px;
      border-radius: 24px;
      overflow: hidden;
      margin-bottom: 0.5rem;
      box-shadow: 0 10px 28px rgba(0, 0, 0, 0.14);
      border: 1px solid var(--border-subtle);
      background: var(--bg-surface);
      display: flex;
      align-items: center;
      justify-content: center;
      transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease;
    }

    .auth-brand-logo-wrap:hover {
      transform: scale(1.04);
      box-shadow: 0 14px 34px rgba(47, 111, 94, 0.25);
    }

    .auth-brand-logo-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    /* Dynamic Theme Logo Switching */
    :root[data-theme="light"] .theme-logo-dark { display: none !important; }
    :root[data-theme="light"] .theme-logo-light { display: block !important; }
    :root[data-theme="dark"] .theme-logo-dark { display: block !important; }
    :root[data-theme="dark"] .theme-logo-light { display: none !important; }

    .auth-logo-badge {
      width: 50px;
      height: 50px;
      border-radius: 16px;
      background: var(--accent);
      color: #FFFFFF;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 22px;
      margin-bottom: 0.25rem;
      box-shadow: 0 4px 12px rgba(47, 111, 94, 0.3);
    }

    .auth-title {
      font-size: 1.45rem;
      font-weight: 700;
      color: var(--text-primary);
      letter-spacing: -0.4px;
    }

    .auth-subtitle {
      font-size: 13px;
      color: var(--text-secondary);
      line-height: 1.4;
    }

    .auth-tabs {
      display: flex;
      background: var(--bg-surface-2);
      padding: 4px;
      border-radius: 12px;
      border: 1px solid var(--border-subtle);
    }

    .auth-tab-btn {
      flex: 1;
      padding: 0.55rem;
      border: none;
      background: transparent;
      color: var(--text-secondary);
      font-size: 13px;
      font-weight: 500;
      border-radius: 9px;
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .auth-tab-btn.active {
      background: var(--bg-surface);
      color: var(--text-primary);
      font-weight: 600;
      box-shadow: var(--shadow-sm);
    }

    .auth-alert {
      padding: 0.75rem 1rem;
      border-radius: 10px;
      font-size: 13px;
      display: none;
      align-items: center;
      gap: 0.5rem;
      line-height: 1.4;
    }

    .auth-alert-error {
      background: rgba(214, 69, 69, 0.1);
      border: 1px solid var(--state-risk);
      color: var(--state-risk);
    }

    .quick-demo-section {
      background: var(--bg-surface-2);
      border: 1px dashed var(--border-strong);
      border-radius: 14px;
      padding: 0.85rem 1rem;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .quick-demo-title {
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      color: var(--text-tertiary);
      letter-spacing: 0.5px;
    }

    .quick-chips {
      display: flex;
      gap: 0.5rem;
    }

    .quick-chip-btn {
      flex: 1;
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: 8px;
      padding: 0.45rem 0.65rem;
      font-size: 12px;
      color: var(--text-primary);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
      transition: all 0.15s ease;
    }

    .quick-chip-btn:hover {
      border-color: var(--accent);
      background: var(--accent-dim);
    }

    /* Sidebar Profile Bar */
    .user-profile-bar {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.75rem 0.5rem;
      margin-top: auto;
      border-top: 1px solid var(--border-subtle);
    }

    .user-avatar-circle {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: var(--accent);
      color: #FFFFFF;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 13px;
      flex-shrink: 0;
    }

    .user-details {
      display: flex;
      flex-direction: column;
      overflow: hidden;
      flex: 1;
    }

    .user-display-name {
      font-size: 13px;
      font-weight: 600;
      color: var(--text-primary);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .user-role-badge {
      font-size: 10px;
      font-family: 'IBM Plex Mono', monospace;
      color: var(--text-secondary);
    }

    .logout-action-btn {
      background: transparent;
      border: none;
      color: var(--text-tertiary);
      cursor: pointer;
      padding: 0.4rem;
      border-radius: 6px;
      font-size: 15px;
      transition: color 0.15s ease, background 0.15s ease;
    }

    .logout-action-btn:hover {
      color: var(--state-risk);
      background: var(--bg-surface-2);
    }

    /* Responsive adjustments */
    @media (max-width: 768px) {
      aside.sidebar { width: 100%; height: 60px; top: auto; bottom: 0; border-right: none; border-top: 1px solid var(--border-subtle); flex-direction: row; padding: 0 1rem; }
      main.main-content { margin-left: 0; margin-bottom: 60px; }
      .brand-header, .nav-section-title, .sidebar-footer, .user-profile-bar { display: none; }
      .topbar-logo-mobile { display: block !important; }
      .nav-section { display: flex; width: 100%; justify-content: space-around; margin: 0; }
    /* ERP High-Speed Absentees Chip Grid */
    .chip-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 0.75rem;
    }

    .student-chip {
      background: var(--bg-surface);
      border: 2px solid var(--state-safe);
      border-radius: 12px;
      padding: 0.75rem 0.9rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      cursor: pointer;
      user-select: none;
      transition: all 0.15s cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: var(--shadow-sm);
    }

    .student-chip:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
    }

    .student-chip.chip-absent {
      border-color: var(--state-risk);
      background: rgba(214, 69, 69, 0.08);
    }

    .chip-left {
      display: flex;
      flex-direction: column;
      gap: 2px;
      min-width: 0;
    }

    .chip-roll {
      font-size: 11px;
      font-weight: 700;
      color: var(--text-secondary);
      font-family: 'IBM Plex Mono', monospace;
    }

    .chip-name {
      font-size: 13px;
      font-weight: 600;
      color: var(--text-primary);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .student-chip.chip-absent .chip-name {
      text-decoration: line-through;
      color: var(--state-risk);
    }

    .chip-badge {
      font-size: 11px;
      font-weight: 700;
      padding: 3px 8px;
      border-radius: 6px;
      flex-shrink: 0;
      transition: all 0.15s ease;
    }

    .badge-present {
      background: rgba(47, 158, 110, 0.15);
      color: var(--state-safe);
    }

    .badge-absent {
      background: rgba(214, 69, 69, 0.2);
      color: var(--state-risk);
    }

    /* Live Attendance Counter Bar */
    .counter-bar-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: 14px;
      padding: 1.15rem 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.25rem;
      box-shadow: var(--shadow-sm);
      position: sticky;
      top: 60px;
      z-index: 30;
      backdrop-filter: blur(12px);
    }

    .counter-stat {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .counter-label {
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--text-tertiary);
    }

    .counter-val {
      font-size: 1.65rem;
      font-weight: 800;
      line-height: 1;
      font-family: 'IBM Plex Mono', monospace;
    }

    .val-total { color: var(--text-primary); }
    .val-present { color: var(--state-safe); }
    .val-absent { color: var(--state-risk); }
    .val-rate { color: var(--accent); }

    /* Modal dialogs */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(8px);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 100;
      padding: 1rem;
    }

    .modal-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: 16px;
      padding: 1.75rem;
      max-width: 650px;
      width: 100%;
      max-height: 90vh;
      overflow-y: auto;
      box-shadow: 0 20px 48px rgba(0, 0, 0, 0.3);
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    /* Defaulter notice A4 printable styles */
    @media print {
      body * { visibility: hidden; }
      #printable-defaulter-notice, #printable-defaulter-notice * { visibility: visible; }
      #printable-defaulter-notice { position: absolute; left: 0; top: 0; width: 100%; border: none !important; box-shadow: none !important; }
      aside.sidebar, header.topbar { display: none !important; }
    }
  </style>
</head>
<body>

  <div class="app-shell">
    
    <!-- Left Navigation Sidebar -->
    <aside class="sidebar">
      <div class="brand-header">
        <div class="brand-icon-wrap">
          <img src="assets/icon.png" alt="OpenAttend Logo" />
        </div>
        <div class="brand-text-wrap">
          <span class="brand-title">OpenAttend</span>
          <span class="brand-subtitle">VESIT • Attendance</span>
        </div>
      </div>

      <!-- Student Navigation Group -->
      <div class="nav-section" id="student-nav-group">
        <div class="nav-section-title">STUDENT</div>
        <div class="nav-item active" onclick="switchView('dashboard', this)"><span>📊</span> Dashboard</div>
        <div class="nav-item" onclick="switchView('analytics', this)"><span>📈</span> Analytics</div>
        <div class="nav-item" onclick="switchView('predictor', this)"><span>⚡</span> Predictor</div>
        <div class="nav-item" onclick="switchView('history', this)"><span>📜</span> History</div>
        <div class="nav-item" onclick="switchView('notifications', this)"><span>🔔</span> Notifications</div>
      </div>

      <!-- Faculty Navigation Group -->
      <div class="nav-section" id="faculty-nav-group" style="display: none;">
        <div class="nav-section-title">CLASSROOM ATTENDANCE</div>
        <div class="nav-item active" onclick="switchView('faculty-marking', this)"><span>⚡</span> Mark Attendance</div>
        <div class="nav-item" onclick="switchView('faculty-history', this)"><span>📜</span> Sessions & 48h Edit</div>
      </div>

      <!-- Class Teacher Navigation Group -->
      <div class="nav-section" id="ct-nav-group" style="display: none;">
        <div class="nav-section-title">DIVISION MGMT</div>
        <div class="nav-item" onclick="switchView('ct-defaulters', this)"><span>📑</span> Defaulter Notice (<75%)</div>
        <div class="nav-item" onclick="switchView('admin-roster', this)"><span>👥</span> Master Roster Upload</div>
      </div>

      <!-- Admin Navigation Group -->
      <div class="nav-section" id="admin-nav-group" style="display: none;">
        <div class="nav-section-title">ADMIN AUDIT</div>
        <div class="nav-item" onclick="switchView('admin-logs', this)"><span>📋</span> Audit Logs</div>
      </div>

      <!-- Sidebar User Profile Bar -->
      <div class="user-profile-bar" id="user-profile-bar" style="display: none;">
        <div class="user-avatar-circle" id="user-avatar-initials">VG</div>
        <div class="user-details">
          <div class="user-display-name" id="user-name-display">Vedant Gharat</div>
          <div class="user-role-badge" id="user-role-display">STUDENT • 2024CS01</div>
        </div>
        <button class="logout-action-btn" title="Sign Out" onclick="handleLogout()">🚪</button>
      </div>

      <!-- Sidebar Footer with Role Switcher -->
      <div class="sidebar-footer">
        <div class="role-switcher" style="display: flex; flex-direction: column; gap: 4px;">
          <div style="display: flex; gap: 3px;">
            <button class="role-btn active" id="btn-role-student" onclick="toggleRole('STUDENT')">🎓 Student</button>
            <button class="role-btn" id="btn-role-faculty" onclick="toggleRole('FACULTY')">👨‍🏫 Faculty</button>
          </div>
          <div style="display: flex; gap: 3px;">
            <button class="role-btn" id="btn-role-ct" onclick="toggleRole('CLASS_TEACHER')">📋 Class Teacher</button>
            <button class="role-btn" id="btn-role-admin" onclick="toggleRole('ADMIN')">⚡ Admin</button>
          </div>
        </div>
      </div>
    </aside>

    <!-- Glassmorphic Login Overlay Modal -->
    <div class="auth-overlay" id="auth-modal">
      <div class="auth-card">
        <div class="auth-header">
          <div class="auth-brand-logo-wrap">
            <img src="assets/logo-light.png" alt="OpenAttend Logo" class="theme-logo-light" />
            <img src="assets/logo-dark.png" alt="OpenAttend Logo" class="theme-logo-dark" />
          </div>
          <h2 class="auth-title">Welcome to OpenAttend</h2>
          <p class="auth-subtitle">Sign in with your official VESIT institutional email address (<span style="font-family: monospace;">@ves.ac.in</span>)</p>
        </div>

        <div class="auth-tabs" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 3px;">
          <button class="auth-tab-btn active" id="auth-tab-student" onclick="switchAuthTab('STUDENT')">🎓 Student</button>
          <button class="auth-tab-btn" id="auth-tab-faculty" onclick="switchAuthTab('FACULTY')">👨‍🏫 Faculty</button>
          <button class="auth-tab-btn" id="auth-tab-classteacher" onclick="switchAuthTab('CLASS_TEACHER')">📋 Teacher</button>
          <button class="auth-tab-btn" id="auth-tab-admin" onclick="switchAuthTab('ADMIN')">⚡ Admin</button>
        </div>

        <div class="auth-alert auth-alert-error" id="auth-error-alert">
          <span>⚠️</span>
          <span id="auth-error-text">Invalid email or password</span>
        </div>

        <form id="auth-login-form" onsubmit="submitAuthLogin(event)" style="display: flex; flex-direction: column; gap: 1rem;">
          <div class="form-group">
            <label class="form-label" for="auth-email-input">Official Institutional Email</label>
            <input type="email" id="auth-email-input" class="form-input" placeholder="student@ves.ac.in" required autocomplete="email">
          </div>

          <div class="form-group">
            <label class="form-label" for="auth-password-input">Password <span style="font-weight: 400; font-size: 11px; color: var(--text-tertiary);">(Default: email)</span></label>
            <input type="password" id="auth-password-input" class="form-input" placeholder="••••••••" required autocomplete="current-password">
          </div>

          <button type="submit" class="btn btn-primary" id="auth-submit-btn" style="width: 100%; padding: 0.75rem; font-size: 14px; margin-top: 0.25rem;">
            Sign In to OpenAttend ERP →
          </button>
        </form>

        <div class="quick-demo-section">
          <div class="quick-demo-title">⚡ Instant 1-Click Login:</div>
          <div class="quick-chips" style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
            <button type="button" class="quick-chip-btn" onclick="fillQuickDemo('STUDENT')">
              <span>🎓</span> Student Demo
            </button>
            <button type="button" class="quick-chip-btn" onclick="fillQuickDemo('FACULTY')">
              <span>👨‍🏫</span> Faculty Demo
            </button>
            <button type="button" class="quick-chip-btn" onclick="fillQuickDemo('CLASS_TEACHER')">
              <span>📋</span> Class Teacher
            </button>
            <button type="button" class="quick-chip-btn" onclick="fillQuickDemo('ADMIN')">
              <span>⚡</span> Admin Demo
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Content Area -->
    <main class="main-content">
      
      <!-- Top Bar -->
      <header class="topbar">
        <div class="topbar-left">
          <img src="assets/icon.png" alt="OpenAttend Logo" class="topbar-logo-mobile" />
          <h1 class="page-title" id="view-title">Student Dashboard</h1>
        </div>
        <div class="topbar-right">
          <div class="sync-pulse-bar">
            <div class="pulse-dot"></div>
            <span id="sync-pulse-text">Synced 4m ago • Google Sheets API</span>
          </div>
          <button class="theme-toggle-btn" onclick="toggleTheme()">🌗 Theme</button>
        </div>
      </header>

      <!-- View Container -->
      <div class="content-viewport" id="viewport">
        
        <!-- View 1: Student Dashboard -->
        <div class="view-pane" id="pane-dashboard">
          
          <!-- Hero Card: Percentage Ring -->
          <div class="hero-ring-card">
            <div class="ring-wrapper">
              <svg width="140" height="140" viewBox="0 0 140 140">
                <circle cx="70" cy="70" r="60" fill="none" stroke="var(--bg-surface-2)" stroke-width="10" />
                <circle cx="70" cy="70" r="60" fill="none" stroke="var(--state-safe)" stroke-width="10" stroke-dasharray="377" stroke-dashoffset="66" stroke-linecap="round" transform="rotate(-90 70 70)" />
              </svg>
              <div class="ring-center-text">
                <div class="ring-center-val font-mono">82.4%</div>
                <div class="ring-center-lbl">Overall</div>
              </div>
            </div>
            <div class="hero-metrics">
              <div class="student-info-row">
                <span class="student-name">Vedant Sharma</span>
                <span class="badge-chip">Roll: 2024CS01</span>
              </div>
              <div class="stats-kpi-grid">
                <div class="kpi-item">
                  <span class="kpi-num font-mono" style="color: var(--state-safe)">141</span>
                  <span class="kpi-label">Present</span>
                </div>
                <div class="kpi-item">
                  <span class="kpi-num font-mono" style="color: var(--state-risk)">30</span>
                  <span class="kpi-label">Absent</span>
                </div>
                <div class="kpi-item">
                  <span class="kpi-num font-mono">171</span>
                  <span class="kpi-label">Total Conducted</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Predictor Callout Component -->
          <div class="predictor-callout-card">
            <div class="predictor-sentence">
              You can safely miss <span class="predictor-num font-mono">16</span> consecutive lectures overall while maintaining attendance above the mandatory <strong>75%</strong> threshold.
            </div>
            <div class="predictor-formula-toggle" onclick="toggleFormula('formula-dash')">
              ▶ How is this calculated?
            </div>
            <div class="predictor-formula-panel" id="formula-dash" style="display: none;">
              <code>Safe Skips S = floor((Present - threshold * Total) / threshold)</code><br>
              Plugging in: floor((141 - 0.75 * 171) / 0.75) = floor((141 - 128.25) / 0.75) = <strong>16 lectures</strong>.
            </div>
          </div>

          <!-- Subject Cards Grid -->
          <h2 style="font-size: 1.1rem; font-weight: 600; margin-top: 0.5rem;">Subject Wise Breakdown</h2>
          <div class="cards-grid">
            <div class="subject-card safe-border">
              <div class="sc-header">
                <div>
                  <div class="sc-code">CS401</div>
                  <div class="sc-title">Data Structures & Algorithms</div>
                </div>
                <div class="sc-pct font-mono" style="color: var(--state-safe)">85.7%</div>
              </div>
              <div class="sc-progress-bar">
                <div class="sc-progress-fill" style="width: 85.7%; background: var(--state-safe)"></div>
              </div>
              <div class="sc-footer">
                <span>36 / 42 Lectures</span>
                <span>Safe Skips: 6</span>
              </div>
            </div>

            <div class="subject-card safe-border">
              <div class="sc-header">
                <div>
                  <div class="sc-code">CS402</div>
                  <div class="sc-title">Operating Systems</div>
                </div>
                <div class="sc-pct font-mono" style="color: var(--state-safe)">81.8%</div>
              </div>
              <div class="sc-progress-bar">
                <div class="sc-progress-fill" style="width: 81.8%; background: var(--state-safe)"></div>
              </div>
              <div class="sc-footer">
                <span>36 / 44 Lectures</span>
                <span>Safe Skips: 4</span>
              </div>
            </div>

            <div class="subject-card risk-border">
              <div class="sc-header">
                <div>
                  <div class="sc-code">CS403</div>
                  <div class="sc-title">Database Management Systems</div>
                </div>
                <div class="sc-pct font-mono" style="color: var(--state-risk)">72.5%</div>
              </div>
              <div class="sc-progress-bar">
                <div class="sc-progress-fill" style="width: 72.5%; background: var(--state-risk)"></div>
              </div>
              <div class="sc-footer">
                <span>29 / 40 Lectures</span>
                <span style="color: var(--state-risk); font-weight: 600">Must attend: 2</span>
              </div>
            </div>
          </div>

          <!-- Atomic RollCallRow Stack -->
          <h2 style="font-size: 1.1rem; font-weight: 600; margin-top: 0.5rem;">Recent Roll Call Log</h2>
          <div class="roll-call-stack">
            <div class="roll-call-row">
              <div class="rc-date font-mono">Aug 02, 2026</div>
              <div class="rc-subject">CS401 • Data Structures</div>
              <div class="rc-status"><div class="status-dot dot-safe"></div><span>Present</span></div>
              <div class="rc-detail">Faculty: Dr. Rao</div>
            </div>
            <div class="roll-call-row">
              <div class="rc-date font-mono">Aug 02, 2026</div>
              <div class="rc-subject">CS402 • Operating Systems</div>
              <div class="rc-status"><div class="status-dot dot-safe"></div><span>Present</span></div>
              <div class="rc-detail">Faculty: Prof. Patil</div>
            </div>
            <div class="roll-call-row">
              <div class="rc-date font-mono">Aug 01, 2026</div>
              <div class="rc-subject">CS403 • Database Systems</div>
              <div class="rc-status"><div class="status-dot dot-risk"></div><span>Absent</span></div>
              <div class="rc-detail">Faculty: Dr. Sharma</div>
            </div>
          </div>
        </div>

        <!-- View 2: Analytics -->
        <div class="view-pane" id="pane-analytics" style="display: none; flex-direction: column; gap: 1.5rem;">
          <div class="form-panel">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
              <div>
                <h3 style="font-size: 1.15rem; font-weight: 600;">Attendance Performance Trends</h3>
                <p style="color: var(--text-secondary); font-size: 13px;">Weekly aggregated trend vs 75% required institutional threshold (PRD §2.5).</p>
              </div>
              <div class="sub-tabs" style="border: none; padding: 0;">
                <button class="sub-tab-btn active">Weekly</button>
                <button class="sub-tab-btn">Monthly</button>
              </div>
            </div>

            <!-- SVG Trend Line Chart -->
            <div style="background: var(--bg-surface-2); border: 1px solid var(--border-subtle); border-radius: 12px; padding: 1.5rem; position: relative;">
              <div style="font-size: 12px; font-weight: 600; color: var(--text-secondary); margin-bottom: 0.75rem;">Overall Attendance % Over Time</div>
              <svg viewBox="0 0 500 150" style="width: 100%; height: 160px; overflow: visible;">
                <!-- 75% Threshold Reference Line -->
                <line x1="0" y1="60" x2="500" y2="60" stroke="var(--state-risk)" stroke-dasharray="4 4" stroke-width="1.5" />
                <text x="495" y="55" fill="var(--state-risk)" font-size="10" font-weight="600" text-anchor="end">75% Threshold</text>
                
                <!-- Trend Curve Line -->
                <polyline fill="none" stroke="var(--accent)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"
                  points="30,85 150,72 275,38 430,48" />

                <!-- Data Points -->
                <circle cx="30" cy="85" r="5" fill="var(--bg-surface)" stroke="var(--accent)" stroke-width="2" />
                <text x="30" y="110" fill="var(--text-tertiary)" font-size="11" text-anchor="middle">W1 (78.0%)</text>

                <circle cx="150" cy="72" r="5" fill="var(--bg-surface)" stroke="var(--accent)" stroke-width="2" />
                <text x="150" y="110" fill="var(--text-tertiary)" font-size="11" text-anchor="middle">W2 (79.5%)</text>

                <circle cx="275" cy="38" r="5" fill="var(--bg-surface)" stroke="var(--accent)" stroke-width="2" />
                <text x="275" y="110" fill="var(--text-tertiary)" font-size="11" text-anchor="middle">W3 (82.1%)</text>

                <circle cx="430" cy="48" r="5" fill="var(--bg-surface)" stroke="var(--accent)" stroke-width="2" />
                <text x="430" y="110" fill="var(--text-tertiary)" font-size="11" text-anchor="middle">W4 (80.2%)</text>
              </svg>
            </div>

            <!-- Subject Comparison Bar Chart (Sorted Risk-First) -->
            <h4 style="font-size: 1rem; font-weight: 600; margin-top: 0.5rem;">Subject Comparison & Deltas</h4>
            <div style="display: flex; flex-direction: column; gap: 1rem;">
              <div style="display: flex; flex-direction: column; gap: 0.4rem;">
                <div style="display: flex; justify-content: space-between; font-size: 13px;">
                  <span style="font-weight: 600;">CS403 • Database Systems</span>
                  <span class="font-mono" style="color: var(--state-risk); font-weight: 600;">72.5% <span style="font-size: 11px;">(▼ 2.1%)</span></span>
                </div>
                <div class="sc-progress-bar" style="height: 10px;">
                  <div class="sc-progress-fill" style="width: 72.5%; background: var(--state-risk)"></div>
                </div>
              </div>

              <div style="display: flex; flex-direction: column; gap: 0.4rem;">
                <div style="display: flex; justify-content: space-between; font-size: 13px;">
                  <span style="font-weight: 600;">CS402 • Operating Systems</span>
                  <span class="font-mono" style="color: var(--state-safe); font-weight: 600;">81.8% <span style="font-size: 11px;">(▲ 1.4%)</span></span>
                </div>
                <div class="sc-progress-bar" style="height: 10px;">
                  <div class="sc-progress-fill" style="width: 81.8%; background: var(--state-safe)"></div>
                </div>
              </div>

              <div style="display: flex; flex-direction: column; gap: 0.4rem;">
                <div style="display: flex; justify-content: space-between; font-size: 13px;">
                  <span style="font-weight: 600;">CS401 • Data Structures</span>
                  <span class="font-mono" style="color: var(--state-safe); font-weight: 600;">85.7% <span style="font-size: 11px;">(▲ 0.5%)</span></span>
                </div>
                <div class="sc-progress-bar" style="height: 10px;">
                  <div class="sc-progress-fill" style="width: 85.7%; background: var(--state-safe)"></div>
                </div>
              </div>
            </div>

          </div>
        </div>

        <!-- View 3: Predictor -->
        <div class="view-pane" id="pane-predictor" style="display: none; flex-direction: column; gap: 1.5rem;">
          <div class="form-panel" style="padding: 2rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
              <div>
                <h2 style="font-size: 1.3rem; font-weight: 700;">Attendance Predictor Sandbox</h2>
                <p style="color: var(--text-secondary); font-size: 13px;">Interactive calculation engine based on PRD §6.4 formulas.</p>
              </div>
              <div class="form-group" style="width: 220px; margin: 0;">
                <select class="form-select" id="predictor-subject-select" onchange="updatePredictorView(this.value)">
                  <option value="overall" selected>Overall Attendance</option>
                  <option value="CS401">CS401 • Data Structures</option>
                  <option value="CS402">CS402 • Operating Systems</option>
                  <option value="CS403">CS403 • Database Systems</option>
                </select>
              </div>
            </div>

            <!-- Predictor Centerpiece Callout -->
            <div class="predictor-callout-card" id="predictor-centerpiece" style="padding: 1.75rem; border-radius: 12px; background: var(--accent-dim); border: 1px solid var(--accent);">
              <div style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; color: var(--accent); margin-bottom: 0.5rem;">Status: Safe Above 75%</div>
              <div class="predictor-sentence" id="predictor-sentence-text" style="font-size: 1.25rem;">
                You can miss <span class="predictor-num font-mono" id="predictor-skips-val" style="font-size: 1.75rem;">8</span> more consecutive lectures while keeping overall attendance above <strong>75%</strong>.
              </div>
            </div>

            <!-- Formula Transparency Panel -->
            <div class="predictor-formula-panel" style="margin-top: 0.5rem; background: var(--bg-surface-2);">
              <div style="font-weight: 600; color: var(--text-primary); margin-bottom: 0.5rem;">🔢 Calculation Breakdown (PRD §6.4 Transparent Formula)</div>
              <div class="font-mono" id="predictor-formula-breakdown" style="line-height: 1.7; font-size: 12px;">
                Formula: Safe Skips = floor((P - (threshold × T)) / threshold)<br>
                Inputs: P = 101 present, T = 126 total, threshold = 0.75<br>
                Calculation: (101 - (0.75 × 126)) / 0.75 = (101 - 94.5) / 0.75 = 6.5 / 0.75 = 8 skips
              </div>
            </div>
          </div>
        </div>

        <!-- View 4: History -->
        <div class="view-pane" id="pane-history" style="display: none; flex-direction: column; gap: 1.25rem;">
          <!-- Filter & Export Controls -->
          <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; background: var(--bg-surface); padding: 1rem 1.25rem; border-radius: 12px; border: 1px solid var(--border-subtle);">
            <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; flex: 1;">
              <select class="form-select" id="history-filter-subject" style="font-size: 13px;" onchange="filterHistoryTable()">
                <option value="all">All Subjects</option>
                <option value="CS401">CS401 • Data Structures</option>
                <option value="CS402">CS402 • Operating Systems</option>
                <option value="CS403">CS403 • Database Systems</option>
              </select>
              <select class="form-select" id="history-filter-status" style="font-size: 13px;" onchange="filterHistoryTable()">
                <option value="all">All Statuses</option>
                <option value="Present">Present</option>
                <option value="Absent">Absent</option>
              </select>
              <input type="text" class="form-input" id="history-search-input" placeholder="Search faculty or remarks..." style="font-size: 13px; min-width: 200px;" oninput="filterHistoryTable()">
            </div>
            <button class="btn btn-secondary" onclick="exportHistoryCSV()" style="font-size: 13px; height: 38px;">📥 Export CSV</button>
          </div>

          <!-- Roll Call Log Table Stack -->
          <div class="roll-call-stack" id="history-rollcall-stack">
            <div class="roll-call-row" data-subject="CS401" data-status="Present" data-text="dr rao binary trees">
              <div class="rc-date font-mono">Aug 05, 2026</div>
              <div class="rc-subject">CS401 • Data Structures</div>
              <div class="rc-status"><div class="status-dot dot-safe"></div><span>Present</span></div>
              <div class="rc-detail">Dr. Rao • Lecture 12 - Binary Trees</div>
            </div>
            <div class="roll-call-row" data-subject="CS402" data-status="Present" data-text="prof sharma process scheduling">
              <div class="rc-date font-mono">Aug 04, 2026</div>
              <div class="rc-subject">CS402 • Operating Systems</div>
              <div class="rc-status"><div class="status-dot dot-safe"></div><span>Present</span></div>
              <div class="rc-detail">Prof. Sharma • Process Scheduling</div>
            </div>
            <div class="roll-call-row" data-subject="CS403" data-status="Absent" data-text="dr patel normalized schemas">
              <div class="rc-date font-mono">Aug 03, 2026</div>
              <div class="rc-subject">CS403 • Database Systems</div>
              <div class="rc-status"><div class="status-dot dot-risk"></div><span>Absent</span></div>
              <div class="rc-detail">Dr. Patel • Normalized Schemas</div>
            </div>
            <div class="roll-call-row" data-subject="CS401" data-status="Present" data-text="dr rao heap data structures">
              <div class="rc-date font-mono">Aug 02, 2026</div>
              <div class="rc-subject">CS401 • Data Structures</div>
              <div class="rc-status"><div class="status-dot dot-safe"></div><span>Present</span></div>
              <div class="rc-detail">Dr. Rao • Heap Data Structures</div>
            </div>
          </div>
        </div>

        <!-- View 5: Notifications -->
        <div class="view-pane" id="pane-notifications" style="display: none; flex-direction: column; gap: 1.25rem;">
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <h3 style="font-size: 1.1rem; font-weight: 600;">Notifications & Alerts</h3>
            <button class="btn btn-secondary" onclick="markAllNotificationsRead()" style="font-size: 12px; padding: 0.4rem 0.85rem;">✓ Mark All as Read</button>
          </div>

          <div class="roll-call-stack">
            <div class="roll-call-row" style="background: var(--bg-surface);">

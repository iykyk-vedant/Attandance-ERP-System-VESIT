                  <option value="D12B">D12B (Full Division - 38 Students)</option>
                  <option value="D12B-B1">D12B • Batch B1 (Lab Cohort)</option>
                  <option value="D12B-B2">D12B • Batch B2 (Lab Cohort)</option>
                  <option value="D12B-B3">D12B • Batch B3 (Lab Cohort)</option>
                </select>
              </div>

              <div class="form-group">
                <label class="form-label" for="marking-date-input">Lecture Date</label>
                <input type="date" class="form-input font-mono" id="marking-date-input" />
              </div>

              <div class="form-group">
                <label class="form-label" for="marking-slot-select">Timetable Slot</label>
                <select class="form-select font-mono" id="marking-slot-select">
                  <option value="1">Slot 1 • 09:00 - 10:00 AM</option>
                  <option value="2">Slot 2 • 10:00 - 11:00 AM</option>
                  <option value="3">Slot 3 • 11:15 - 12:15 PM</option>
                  <option value="4">Slot 4 • 12:15 - 01:15 PM</option>
                  <option value="5">Slot 5 • 01:45 - 02:45 PM</option>
                  <option value="6">Slot 6 • 02:45 - 03:45 PM</option>
                </select>
              </div>

              <div class="form-group">
                <label class="form-label" for="marking-type-select">Session Type</label>

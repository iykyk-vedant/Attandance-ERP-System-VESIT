        <!-- Faculty View 1: Classroom Attendance Marking (High-Speed Absentees Mode) -->
        <div class="view-pane" id="pane-faculty-marking" style="display: none; flex-direction: column; gap: 1.25rem;">
          <div class="admin-hero-banner" style="max-height: 140px;">
            <img src="assets/banner-dark.png" alt="OpenAttend Platform" class="admin-banner-img">
          </div>

          <!-- Session Controls Card -->
          <div class="form-panel" style="padding: 1.25rem 1.5rem; gap: 1rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
              <div>
                <h2 style="font-size: 1.25rem; font-weight: 700; color: var(--text-primary); display: flex; align-items: center; gap: 0.5rem;">
                  <span>⚡</span> Live Classroom Attendance
                </h2>
                <p style="color: var(--text-secondary); font-size: 12px; margin-top: 2px;">
                  High-speed absentees mode: Tap only the absent students. Submits in under 10 seconds.
                </p>
              </div>
              <span class="tab-chip" style="background: var(--accent-dim); color: var(--accent); font-weight: 700;">

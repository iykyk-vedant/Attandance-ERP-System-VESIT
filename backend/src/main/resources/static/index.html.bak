              </div>
              <input type="text" id="chip-filter-search" class="form-input" placeholder="🔍 Search Roll No or Name..." oninput="filterChips(this.value)" style="max-width: 250px; font-size: 12px; padding: 0.4rem 0.75rem;" />
            </div>

            <!-- Student Chips Container -->
            <div class="chip-grid" id="faculty-student-grid">
              <!-- Populated dynamically via JS -->
            </div>
          </div>

          <!-- Submission Action Bar -->
          <div style="margin-top: 0.5rem; display: flex; flex-direction: column; gap: 0.75rem;">
            <div id="marking-feedback-banner" style="display: none; padding: 1rem; border-radius: 10px; font-size: 13px; font-weight: 600;"></div>
            <button class="btn btn-primary" id="btn-submit-marking" onclick="submitClassroomAttendance()" style="font-size: 15px; padding: 0.9rem 1.5rem; width: 100%;">
              ⚡ Submit Classroom Attendance (< 10s) →
            </button>
          </div>
        </div>

        <!-- Faculty View 2: Session History & 48h Corrections -->
        <div class="view-pane" id="pane-faculty-history" style="display: none; flex-direction: column; gap: 1.25rem;">
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <div>
              <h2 style="font-size: 1.25rem; font-weight: 700;">📜 Recorded Sessions & 48h Corrections</h2>
              <p style="color: var(--text-secondary); font-size: 13px; margin-top: 2px;">
                Review submitted attendance sessions. Modify attendance within the 48-hour correction window.
              </p>
            </div>
            <button class="btn btn-secondary" onclick="loadFacultySessions()" style="font-size: 12px;">🔄 Refresh Sessions</button>
          </div>

          <div class="roll-call-stack" id="faculty-sessions-container">
            <!-- Dynamically populated from /api/v1/faculty/sessions -->
          </div>

        <!-- Class Teacher View: Defaulters Notice (<75%) -->
        <div class="view-pane" id="pane-ct-defaulters" style="display: none; flex-direction: column; gap: 1.25rem;">
          <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
            <div>
              <h2 style="font-size: 1.25rem; font-weight: 700;">📑 Division Defaulter Notice & Analytics</h2>
              <p style="color: var(--text-secondary); font-size: 13px; margin-top: 2px;">
                Official VESIT attendance deficit report for students below the 75% statutory threshold.
              </p>
            </div>
            <div style="display: flex; gap: 0.5rem;">
              <button class="btn btn-primary" onclick="window.print()" style="font-size: 13px;">
                🖨️ Print / Save Official A4 PDF
              </button>
            </div>
          </div>

          <div class="form-panel" style="padding: 1.25rem 1.5rem;">
            <div style="display: flex; gap: 1.5rem; align-items: center; flex-wrap: wrap;">
              <div class="form-group" style="min-width: 160px;">
                <label class="form-label">Division</label>
                <select class="form-select" id="defaulter-division-select" onchange="renderDefaultersTable()">
                  <option value="D12B" selected>D12B (Computer Engineering)</option>
                  <option value="D12A">D12A (Computer Engineering)</option>
                </select>
              </div>
              <div class="form-group" style="min-width: 160px;">
                <label class="form-label">Statutory Threshold</label>
                <select class="form-select font-mono" id="defaulter-threshold-select" onchange="renderDefaultersTable()">
                  <option value="75" selected>75% (Mumbai University Norm)</option>
                  <option value="60">60% (Critical Debarment Line)</option>
                </select>
              </div>
              <div style="margin-left: auto; display: flex; gap: 1.5rem; text-align: center;">
                <div>
                  <div style="font-size: 11px; font-weight: 700; color: var(--text-tertiary);">DEFAULTER COUNT</div>
                  <div style="font-size: 1.5rem; font-weight: 800; color: var(--state-risk);" id="defaulter-kpi-count">3</div>
                </div>
                <div>
                  <div style="font-size: 11px; font-weight: 700; color: var(--text-tertiary);">DIVISION AVERAGE</div>
                  <div style="font-size: 1.5rem; font-weight: 800; color: var(--state-safe);">81.4%</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Printable Official Notice Container -->
          <div id="printable-defaulter-notice" style="background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: 12px; padding: 2rem;">
            <div style="text-align: center; border-bottom: 2px solid var(--border-strong); padding-bottom: 1.25rem; margin-bottom: 1.5rem;">
              <div style="font-size: 12px; font-weight: 700; letter-spacing: 1px; color: var(--text-tertiary);">VIVEKANAND EDUCATION SOCIETY'S INSTITUTE OF TECHNOLOGY</div>
              <div style="font-size: 1.3rem; font-weight: 800; color: var(--text-primary); margin: 4px 0;">DEPARTMENT OF COMPUTER ENGINEERING</div>
              <div style="font-size: 13px; font-weight: 600; color: var(--accent);">ATTENDANCE DEFAULTER NOTICE • ACADEMIC YEAR 2025-26 (SEM VI)</div>
              <div style="font-size: 11px; color: var(--text-secondary); margin-top: 4px;">Mandatory Minimum Attendance: 75% • Generated via OpenAttend ERP</div>
            </div>

            <table class="column-preview-table" id="defaulter-table" style="width: 100%; margin-top: 0;">
              <thead>
                <tr>
                  <th>Roll No</th>
                  <th>Student Name</th>
                  <th>Total Lectures</th>
                  <th>Attended</th>
                  <th>Overall Attendance</th>
                  <th>Shortfall</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody id="defaulter-table-body">
                <!-- Dynamically filled -->
              </tbody>
            </table>

            <div style="margin-top: 3rem; display: flex; justify-content: space-between; font-size: 12px; color: var(--text-secondary);">
              <div style="text-align: center;">
                <div style="margin-bottom: 2.5rem;">_____________________________</div>
                <strong>Prof. Sneha Sharma</strong><br>Class Teacher (D12B)
              </div>
              <div style="text-align: center;">
                <div style="margin-bottom: 2.5rem;">_____________________________</div>
                <strong>Dr. Nupur Giri</strong><br>Head of Department (CMPN)
              </div>
            </div>
          </div>
        </div>

        <!-- Admin View 5: Sync Logs with Expandable Details -->
        <div class="view-pane" id="pane-admin-logs" style="display: none; flex-direction: column; gap: 1.25rem;">
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <div>
              <h3 style="font-size: 1.1rem; font-weight: 600;">System Sync Logs</h3>
              <p style="color: var(--text-secondary); font-size: 12px;">Detailed audit log of background sync runs and itemized skip reasons (PRD §11.4).</p>
            </div>
            <button class="btn btn-secondary" onclick="refreshAdminLogs()" style="font-size: 12px;">🔄 Refresh Logs</button>
          </div>

          <div class="roll-call-stack" id="admin-sync-logs-list">
            <div class="roll-call-row" onclick="toggleLogDetail('log-detail-1')" style="cursor: pointer; flex-direction: column; align-items: stretch; gap: 0.5rem;">
              <div style="display: flex; align-items: center; gap: 1rem;">
                <div class="rc-date font-mono">14:00:25</div>
                <div class="rc-subject">CS401 • Data Structures</div>
                <div class="rc-status"><div class="status-dot dot-safe"></div><span>SKIPPED</span></div>
                <div class="rc-detail">42 Rows Read • 0 Upserted</div>
              </div>
              <div id="log-detail-1" style="display: none; font-size: 12px; background: var(--bg-surface-2); padding: 0.65rem 0.85rem; border-radius: 6px; color: var(--text-secondary);" class="font-mono">
                Run Status: SKIPPED_NO_CHANGE<br>
                Content Hash: 8f4a21b3... SHA-256<br>
                Detail: Range hash matched existing check; zero changes detected.
              </div>
            </div>

            <div class="roll-call-row" onclick="toggleLogDetail('log-detail-2')" style="cursor: pointer; flex-direction: column; align-items: stretch; gap: 0.5rem;">
              <div style="display: flex; align-items: center; gap: 1rem;">
                <div class="rc-date font-mono">13:45:10</div>
                <div class="rc-subject">CS403 • Database Systems</div>
                <div class="rc-status"><div class="status-dot dot-warn"></div><span>PARTIAL</span></div>
                <div class="rc-detail">40 Rows Read • 38 Upserted</div>
              </div>
              <div id="log-detail-2" style="display: none; font-size: 12px; background: var(--bg-surface-2); padding: 0.65rem 0.85rem; border-radius: 6px; color: var(--state-warn);" class="font-mono">
                Run Status: PARTIAL_FAILURE<br>
                Itemized Skip Reasons:<br>
                - Row 14: Invalid date format ("invalid-date")<br>
                - Row 27: Roll number "2024CS99" not found in student roster
              </div>
            </div>
          </div>
        </div>

      </div>
    </main>

    <!-- 48-Hour Attendance Correction Modal -->
    <div class="modal-overlay" id="correction-modal">
      <div class="modal-card">
        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-subtle); padding-bottom: 0.75rem;">
          <h3 style="font-size: 1.15rem; font-weight: 700; display: flex; align-items: center; gap: 0.5rem;">
            <span>✏️</span> 48-Hour Attendance Correction Window
          </h3>
          <button onclick="closeCorrectionModal()" style="background: none; border: none; font-size: 22px; cursor: pointer; color: var(--text-tertiary);">&times;</button>
        </div>

        <div id="correction-session-info" style="background: var(--bg-surface-2); border-radius: 8px; padding: 0.75rem 1rem; font-size: 12px; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;">
          <span id="corr-subject">CS401 • Slot 1</span>
          <span id="corr-date" class="font-mono">2026-09-07</span>
          <span style="color: var(--state-warn); font-weight: 600;">⏳ Audit Trail Active</span>
        </div>

        <div class="form-group">
          <label class="form-label" for="corr-topic-input">Topic Covered</label>
          <input type="text" id="corr-topic-input" class="form-input" />
        </div>

        <div>
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
            <label class="form-label" style="margin-bottom: 0;">Tap student to toggle status for this session:</label>
            <span id="corr-summary-badge" style="font-size: 11px; font-weight: 700; color: var(--text-secondary);"></span>
          </div>
          <div class="chip-grid" id="corr-students-grid" style="max-height: 220px; overflow-y: auto; padding: 2px;">
            <!-- Populated dynamically -->
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="corr-reason-input">
            Mandatory Justification Reason <span style="color: var(--state-risk);">*</span>
          </label>
          <textarea id="corr-reason-input" class="form-input" rows="2" placeholder="State reason (e.g. Student arrived late with verified medical certificate approved by HOD...)" oninput="onReasonInput(this)"></textarea>
          <div style="display: flex; justify-content: space-between; font-size: 11px; color: var(--text-tertiary); margin-top: 2px;">
            <span id="corr-reason-counter">0 / 10 characters minimum</span>
            <span style="color: var(--state-risk);" id="corr-reason-error"></span>
          </div>
        </div>

        <div style="display: flex; justify-content: flex-end; gap: 0.75rem; border-top: 1px solid var(--border-subtle); padding-top: 0.75rem;">
          <button type="button" class="btn btn-secondary" onclick="closeCorrectionModal()">Cancel</button>
          <button type="button" class="btn btn-primary" id="corr-submit-btn" onclick="submitAttendanceCorrection()">💾 Save Correction</button>
        </div>
      </div>
    </div>

  </div>

  <script>
    function toggleTheme() {
      const currentTheme = document.documentElement.getAttribute('data-theme');
      const nextTheme = currentTheme === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', nextTheme);
    }

    function toggleRole(role) {
      const studentNav = document.getElementById('student-nav-group');
      const facultyNav = document.getElementById('faculty-nav-group');
      const ctNav = document.getElementById('ct-nav-group');
      const adminNav = document.getElementById('admin-nav-group');

      const roleButtons = ['student', 'faculty', 'ct', 'admin'];
      roleButtons.forEach(r => {
        const btn = document.getElementById('btn-role-' + r);
        if (btn) btn.classList.remove('active');
      });

      if (studentNav) studentNav.style.display = 'none';
      if (facultyNav) facultyNav.style.display = 'none';
      if (ctNav) ctNav.style.display = 'none';
      if (adminNav) adminNav.style.display = 'none';

      if (role === 'FACULTY') {
        if (facultyNav) facultyNav.style.display = 'block';
        document.getElementById('btn-role-faculty')?.classList.add('active');
        switchView('faculty-marking', facultyNav.querySelector('.nav-item'));
        loadFacultyCohort();
      } else if (role === 'CLASS_TEACHER') {
        if (facultyNav) facultyNav.style.display = 'block';
        if (ctNav) ctNav.style.display = 'block';
        document.getElementById('btn-role-ct')?.classList.add('active');
        switchView('ct-defaulters', ctNav.querySelector('.nav-item'));
        renderDefaultersTable();
      } else if (role === 'ADMIN' || role === 'SUPER_ADMIN') {
        if (facultyNav) facultyNav.style.display = 'block';
        if (ctNav) ctNav.style.display = 'block';
        if (adminNav) adminNav.style.display = 'block';
        document.getElementById('btn-role-admin')?.classList.add('active');
        switchView('admin-roster', ctNav.querySelectorAll('.nav-item')[1]);
      } else {
        if (studentNav) studentNav.style.display = 'block';
        document.getElementById('btn-role-student')?.classList.add('active');
        switchView('dashboard', studentNav.querySelector('.nav-item'));
      }
    }

    function switchView(viewId, el) {
      document.querySelectorAll('.view-pane').forEach(pane => pane.style.display = 'none');
      document.querySelectorAll('.nav-item').forEach(item => item.classList.remove('active'));
      
      const targetPane = document.getElementById('pane-' + viewId);
      if (targetPane) targetPane.style.display = 'flex';
      if (el) el.classList.add('active');

      const titles = {
        'dashboard': 'Student Dashboard',
        'analytics': 'Attendance Analytics',
        'predictor': 'Attendance Predictor',
        'history': 'Attendance History',
        'notifications': 'Notifications',
        'faculty-marking': 'Faculty — Live Classroom Attendance (Absentees Mode)',
        'faculty-history': 'Faculty — Recorded Sessions & 48h Corrections',
        'ct-defaulters': 'Class Teacher — Defaulter Notice (<75%)',
        'admin-roster': 'Admin — Master Roster Import',
        'admin-logs': 'Admin — System Audit Logs'
      };
      document.getElementById('view-title').textContent = titles[viewId] || 'OpenAttend';

      if (viewId === 'faculty-marking') {
        loadFacultyCohort();
      } else if (viewId === 'faculty-history') {
        loadFacultySessions();
      } else if (viewId === 'ct-defaulters') {
        renderDefaultersTable();
      }
    }

    // --- ERP Roster and High-Speed Absentees Marking Engine ---
    const VESIT_D12B_STUDENTS = [
      { studentId: 'usr_d12b_01', rollNo: '2024CS01', name: 'Manav Ahuja', division: 'D12B', batch: 'B1' },
      { studentId: 'usr_d12b_02', rollNo: '2024CS02', name: 'Kashish Amarnani', division: 'D12B', batch: 'B1' },
      { studentId: 'usr_d12b_03', rollNo: '2024CS03', name: 'Japleen Arora', division: 'D12B', batch: 'B1' },
      { studentId: 'usr_d12b_04', rollNo: '2024CS04', name: 'Shruti Awasthi', division: 'D12B', batch: 'B1' },
      { studentId: 'usr_d12b_05', rollNo: '2024CS05', name: 'Unmesh Bhangale', division: 'D12B', batch: 'B1' },
      { studentId: 'usr_d12b_06', rollNo: '2024CS06', name: 'Sia Chhatlani', division: 'D12B', batch: 'B1' },
      { studentId: 'usr_d12b_07', rollNo: '2024CS07', name: 'Kirtan Devadiga', division: 'D12B', batch: 'B1' },
      { studentId: 'usr_d12b_08', rollNo: '2024CS08', name: 'Anushka Dubey', division: 'D12B', batch: 'B1' },
      { studentId: 'usr_d12b_09', rollNo: '2024CS09', name: 'Bhoomit Fatnani', division: 'D12B', batch: 'B1' },
      { studentId: 'usr_d12b_10', rollNo: '2024CS10', name: 'Hitika Galrani', division: 'D12B', batch: 'B1' },
      { studentId: 'usr_d12b_11', rollNo: '2024CS11', name: 'Krishna Gavali', division: 'D12B', batch: 'B1' },
      { studentId: 'usr_d12b_12', rollNo: '2024CS12', name: 'Adhyatmika Ghodvinde', division: 'D12B', batch: 'B1' },
      { studentId: 'usr_d12b_13', rollNo: '2024CS13', name: 'Abhishek Gore', division: 'D12B', batch: 'B2' },
      { studentId: 'usr_d12b_14', rollNo: '2024CS14', name: 'Krrish Gupta', division: 'D12B', batch: 'B2' },
      { studentId: 'usr_d12b_15', rollNo: '2024CS15', name: 'Rushabh Gupta', division: 'D12B', batch: 'B2' },
      { studentId: 'usr_d12b_16', rollNo: '2024CS16', name: 'Dhruv Haswani', division: 'D12B', batch: 'B2' },
      { studentId: 'usr_d12b_17', rollNo: '2024CS17', name: 'Saakhi Hotwani', division: 'D12B', batch: 'B2' },
      { studentId: 'usr_d12b_18', rollNo: '2024CS18', name: 'Aryan Kadam', division: 'D12B', batch: 'B2' },
      { studentId: 'usr_d12b_19', rollNo: '2024CS19', name: 'Arnav Kale', division: 'D12B', batch: 'B2' },
      { studentId: 'usr_d12b_20', rollNo: '2024CS20', name: 'Parth Khismatrao', division: 'D12B', batch: 'B2' },
      { studentId: 'usr_d12b_21', rollNo: '2024CS21', name: 'Shubham Lachhwani', division: 'D12B', batch: 'B2' },
      { studentId: 'usr_d12b_22', rollNo: '2024CS22', name: 'Disha Lalwani', division: 'D12B', batch: 'B2' },
      { studentId: 'usr_d12b_23', rollNo: '2024CS23', name: 'Pari Madhyan', division: 'D12B', batch: 'B2' },
      { studentId: 'usr_d12b_24', rollNo: '2024CS24', name: 'Prasad Mahajan', division: 'D12B', batch: 'B2' },
      { studentId: 'usr_d12b_25', rollNo: '2024CS25', name: 'Lokesh Mainani', division: 'D12B', batch: 'B3' },
      { studentId: 'usr_d12b_26', rollNo: '2024CS26', name: 'Shravani Mankar', division: 'D12B', batch: 'B3' },
      { studentId: 'usr_d12b_27', rollNo: '2024CS27', name: 'Aadit Mascarenhas', division: 'D12B', batch: 'B3' },
      { studentId: 'usr_d12b_28', rollNo: '2024CS28', name: 'Nupur Mhatre', division: 'D12B', batch: 'B3' },
      { studentId: 'usr_d12b_29', rollNo: '2024CS29', name: 'Parth Mohite', division: 'D12B', batch: 'B3' },
      { studentId: 'usr_d12b_30', rollNo: '2024CS30', name: 'Vinay Motwani', division: 'D12B', batch: 'B3' },
      { studentId: 'usr_d12b_31', rollNo: '2024CS31', name: 'Gourish Naik', division: 'D12B', batch: 'B3' },
      { studentId: 'usr_d12b_32', rollNo: '2024CS32', name: 'Vansh Pahuja', division: 'D12B', batch: 'B3' },
      { studentId: 'usr_d12b_33', rollNo: '2024CS33', name: 'Manas Parekar', division: 'D12B', batch: 'B3' },
      { studentId: 'usr_d12b_34', rollNo: '2024CS34', name: 'Aniruddha Patil', division: 'D12B', batch: 'B3' },
      { studentId: 'usr_d12b_35', rollNo: '2024CS35', name: 'Kaustubh Patil', division: 'D12B', batch: 'B3' },
      { studentId: 'usr_d12b_36', rollNo: '2024CS36', name: 'Pradnyesh Patil', division: 'D12B', batch: 'B3' },
      { studentId: 'usr_d12b_37', rollNo: '2024CS37', name: 'Tanay Patil', division: 'D12B', batch: 'B3' },
      { studentId: 'usr_d12b_38', rollNo: '2024CS38', name: 'Vedant Gharat', division: 'D12B', batch: 'B3' }
    ];

    let currentCohort = [...VESIT_D12B_STUDENTS];
    let absentStudentIds = new Set();
    let currentFacultySessions = [];
    let selectedSessionForCorrection = null;
    let corrAbsentStudentIds = new Set();

    function onMarkingSubjectChange() {
      loadFacultyCohort();
    }

    async function loadFacultyCohort() {
      const dateEl = document.getElementById('marking-date-input');
      if (dateEl && !dateEl.value) {
        dateEl.value = new Date().toISOString().slice(0, 10);
      }

      const divVal = document.getElementById('marking-division-select')?.value || 'D12B';
      let division = 'D12B';
      let batch = null;
      if (divVal.includes('-')) {
        const parts = divVal.split('-');
        division = parts[0];
        batch = parts[1];
      }

      const token = currentUserSession?.accessToken;
      const headers = token ? { 'Authorization': 'Bearer ' + token } : {};

      try {
        const res = await fetch(`/api/v1/faculty/roster?division=${division}${batch ? '&batch=' + batch : ''}`, { headers });
        const data = await res.json();
        if (data.success && data.roster && data.roster.length > 0) {
          currentCohort = data.roster;
        } else {
          currentCohort = filterCohortLocally(division, batch);
        }
      } catch (e) {
        currentCohort = filterCohortLocally(division, batch);
      }

      absentStudentIds.clear();
      renderFacultyChips();
      updateCounterBar();
    }

    function filterCohortLocally(division, batch) {
      if (batch) {
        return VESIT_D12B_STUDENTS.filter(s => s.batch === batch);
      }
      return [...VESIT_D12B_STUDENTS];
    }

    function renderFacultyChips() {
      const grid = document.getElementById('faculty-student-grid');
      if (!grid) return;
      grid.innerHTML = '';

      currentCohort.forEach(s => {
        const isAbsent = absentStudentIds.has(s.studentId);
        const chip = document.createElement('div');
        chip.className = 'student-chip' + (isAbsent ? ' chip-absent' : '');
        chip.id = 'chip-' + s.studentId;
        chip.onclick = () => toggleStudentAbsent(s.studentId);

        chip.innerHTML = `
          <div class="chip-left">
            <span class="chip-roll font-mono">${s.rollNo} • ${s.batch || 'Div'}</span>
            <span class="chip-name">${s.name}</span>
          </div>
          <span class="chip-badge ${isAbsent ? 'badge-absent' : 'badge-present'}">
            ${isAbsent ? '❌ Absent' : '✅ Present'}
          </span>
        `;
        grid.appendChild(chip);
      });
    }

    function toggleStudentAbsent(studentId) {
      if (absentStudentIds.has(studentId)) {
        absentStudentIds.delete(studentId);
      } else {
        absentStudentIds.add(studentId);
      }

      const chip = document.getElementById('chip-' + studentId);
      if (chip) {
        const isAbsent = absentStudentIds.has(studentId);
        chip.className = 'student-chip' + (isAbsent ? ' chip-absent' : '');
        const badge = chip.querySelector('.chip-badge');
        if (badge) {
          badge.className = 'chip-badge ' + (isAbsent ? 'badge-absent' : 'badge-present');
          badge.textContent = isAbsent ? '❌ Absent' : '✅ Present';
        }
      }

      updateCounterBar();
    }

    function clearAllAbsentees() {
      absentStudentIds.clear();
      renderFacultyChips();
      updateCounterBar();
    }

    function filterChips(query) {
      const q = (query || '').toLowerCase().trim();
      document.querySelectorAll('#faculty-student-grid .student-chip').forEach(chip => {
        const text = chip.textContent.toLowerCase();
        chip.style.display = (!q || text.includes(q)) ? 'flex' : 'none';
      });
    }

    function updateCounterBar() {
      const total = currentCohort.length;
      const absent = absentStudentIds.size;
      const present = total - absent;
      const rate = total > 0 ? ((present / total) * 100).toFixed(1) + '%' : '100%';

      const elTotal = document.getElementById('counter-total');
      const elPres = document.getElementById('counter-present');
      const elAbs = document.getElementById('counter-absent');
      const elRate = document.getElementById('counter-rate');

      if (elTotal) elTotal.textContent = total;
      if (elPres) elPres.textContent = present;
      if (elAbs) elAbs.textContent = absent;
      if (elRate) elRate.textContent = rate;
    }

    async function submitClassroomAttendance() {
      const btn = document.getElementById('btn-submit-marking');
      const feedback = document.getElementById('marking-feedback-banner');
      btn.disabled = true;
      btn.textContent = '⚡ Recording attendance in database…';

      const subjectId = document.getElementById('marking-subject-select')?.value || 'sub_cs401';
      const divVal = document.getElementById('marking-division-select')?.value || 'D12B';
      let division = 'D12B';
      let batch = null;
      if (divVal.includes('-')) {
        const parts = divVal.split('-');
        division = parts[0];
        batch = parts[1];
      }

      const lectureDate = document.getElementById('marking-date-input')?.value || new Date().toISOString().slice(0, 10);
      const sessionIndex = parseInt(document.getElementById('marking-slot-select')?.value || '1');
      const sessionType = document.getElementById('marking-type-select')?.value || 'LECTURE';
      const topicCovered = document.getElementById('marking-topic-input')?.value || 'Classroom Lecture';

      const payload = {
        subjectId,
        division,
        batch,
        lectureDate,
        sessionIndex,
        sessionType,
        topicCovered,
        absentStudentIds: Array.from(absentStudentIds)
      };

      const token = currentUserSession?.accessToken;
      const headers = { 'Content-Type': 'application/json' };
      if (token) headers['Authorization'] = 'Bearer ' + token;

      try {
        const res = await fetch('/api/v1/faculty/attendance/submit', {
          method: 'POST',
          headers,
          body: JSON.stringify(payload)
        });

        const data = await res.json();
        if (data.success && data.session) {
          showMarkingSuccess(data.session);
        } else {
          showMarkingError(data.message || data.error || 'Attendance submission failed.');
        }
      } catch (err) {
        // Mock fallback confirmation
        const mockSession = {
          id: 'ses_' + Date.now(),
          subjectCode: 'CS401',
          subjectName: 'Data Structures & Algorithms',
          division,
          batch,
          sessionDate: lectureDate,
          sessionIndex,
          totalStudents: currentCohort.length,
          presentCount: currentCohort.length - absentStudentIds.size,
          absentCount: absentStudentIds.size,
          topicCovered,
          canCorrect: true,
          submittedAt: new Date().toISOString()
        };
        currentFacultySessions.unshift(mockSession);
        showMarkingSuccess(mockSession);
      } finally {
        btn.disabled = false;
        btn.textContent = '⚡ Submit Classroom Attendance (< 10s) →';
      }
    }

    function showMarkingSuccess(session) {
      const banner = document.getElementById('marking-feedback-banner');
      if (banner) {
        banner.style.display = 'block';
        banner.style.background = 'rgba(47, 158, 110, 0.15)';
        banner.style.border = '1px solid var(--state-safe)';
        banner.style.color = 'var(--state-safe)';
        banner.innerHTML = `
          ✅ <strong>Classroom Attendance Successfully Recorded!</strong><br>
          <span style="font-size: 12px; color: var(--text-primary); margin-top: 4px; display: inline-block;">
            ${session.subjectCode || 'Session'} • ${session.division} • Slot ${session.sessionIndex} • 
            ${session.presentCount} Present, ${session.absentCount} Absent. 
            Correction window active for 48 hours.
          </span>
        `;
        setTimeout(() => { banner.style.display = 'none'; }, 8000);
      }
    }

    function showMarkingError(msg) {
      const banner = document.getElementById('marking-feedback-banner');
      if (banner) {
        banner.style.display = 'block';
        banner.style.background = 'rgba(214, 69, 69, 0.12)';
        banner.style.border = '1px solid var(--state-risk)';
        banner.style.color = 'var(--state-risk)';
        banner.innerHTML = `⚠️ <strong>Error:</strong> ${msg}`;
      }
    }

    async function loadFacultySessions() {
      const container = document.getElementById('faculty-sessions-container');
      if (!container) return;

      const token = currentUserSession?.accessToken;
      const headers = token ? { 'Authorization': 'Bearer ' + token } : {};

      try {
        const res = await fetch('/api/v1/faculty/sessions', { headers });
        const data = await res.json();
        if (data.success && data.sessions) {
          currentFacultySessions = data.sessions;
        }
      } catch (e) {}

      if (!currentFacultySessions || currentFacultySessions.length === 0) {
        // Seed default sample sessions
        currentFacultySessions = [
          {
            id: 'ses_sample_1',
            subjectCode: 'CS401',
            subjectName: 'Data Structures & Algorithms',
            division: 'D12B',
            batch: null,
            sessionDate: new Date().toISOString().slice(0, 10),
            sessionIndex: 1,
            sessionType: 'LECTURE',
            topicCovered: 'AVL Trees & Rotations',
            totalStudents: 38,
            presentCount: 36,
            absentCount: 2,
            absentStudentIds: ['usr_d12b_07', 'usr_d12b_14'],
            canCorrect: true,
            submittedAt: new Date().toISOString()
          },
          {
            id: 'ses_sample_2',
            subjectCode: 'CS402',
            subjectName: 'Database Management Systems',
            division: 'D12B',
            batch: null,
            sessionDate: new Date(Date.now() - 86400000).toISOString().slice(0, 10),
            sessionIndex: 2,
            sessionType: 'LECTURE',
            topicCovered: 'B+ Trees Indexing Invariants',
            totalStudents: 38,
            presentCount: 37,
            absentCount: 1,
            absentStudentIds: ['usr_d12b_21'],
            canCorrect: true,
            submittedAt: new Date(Date.now() - 86400000).toISOString()
          }
        ];
      }

      container.innerHTML = '';
      currentFacultySessions.forEach(ses => {
        const row = document.createElement('div');
        row.className = 'roll-call-row';
        row.style.display = 'flex';
        row.style.alignItems = 'center';
        row.style.justifyContent = 'space-between';
        row.style.flexWrap = 'wrap';
        row.style.gap = '0.75rem';

        const canEdit = ses.canCorrect !== false;

        row.innerHTML = `
          <div style="display: flex; align-items: center; gap: 1rem; flex: 1; min-width: 260px;">
            <div class="rc-date font-mono">${ses.sessionDate}</div>
            <div style="display: flex; flex-direction: column;">
              <span class="rc-subject" style="font-weight: 700;">${ses.subjectCode} • ${ses.division} (Slot ${ses.sessionIndex})</span>
              <span style="font-size: 11px; color: var(--text-tertiary);">${ses.topicCovered || 'Classroom session'}</span>
            </div>
            <div class="rc-status">
              <div class="status-dot dot-safe"></div>
              <span>${ses.presentCount}/${ses.totalStudents} (${((ses.presentCount/ses.totalStudents)*100).toFixed(0)}%)</span>
            </div>
          </div>
          <div style="display: flex; align-items: center; gap: 0.75rem;">
            <span class="tab-chip" style="font-size: 11px; ${canEdit ? 'color: var(--state-warn); background: rgba(201, 138, 30, 0.12);' : 'color: var(--text-tertiary);'}">
              ${canEdit ? '⏳ 48h Editable' : '🔒 Locked (>48h)'}
            </span>
            ${canEdit ? `<button class="btn btn-secondary" onclick="openCorrectionModal('${ses.id}')" style="font-size: 12px; padding: 0.35rem 0.75rem;">✏️ Correct</button>` : ''}
          </div>
        `;
        container.appendChild(row);
      });
    }

    function openCorrectionModal(sessionId) {
      selectedSessionForCorrection = currentFacultySessions.find(s => s.id === sessionId);
      if (!selectedSessionForCorrection) return;

      document.getElementById('corr-subject').textContent = `${selectedSessionForCorrection.subjectCode} • ${selectedSessionForCorrection.division} (Slot ${selectedSessionForCorrection.sessionIndex})`;
      document.getElementById('corr-date').textContent = selectedSessionForCorrection.sessionDate;
      document.getElementById('corr-topic-input').value = selectedSessionForCorrection.topicCovered || '';
      document.getElementById('corr-reason-input').value = '';
      document.getElementById('corr-reason-counter').textContent = '0 / 10 characters minimum';

      corrAbsentStudentIds = new Set(selectedSessionForCorrection.absentStudentIds || []);
      renderCorrectionChips();

      const modal = document.getElementById('correction-modal');
      if (modal) modal.style.display = 'flex';
    }

    function renderCorrectionChips() {
      const grid = document.getElementById('corr-students-grid');
      if (!grid) return;
      grid.innerHTML = '';

      currentCohort.forEach(s => {
        const isAbsent = corrAbsentStudentIds.has(s.studentId);
        const chip = document.createElement('div');
        chip.className = 'student-chip' + (isAbsent ? ' chip-absent' : '');
        chip.onclick = () => {
          if (corrAbsentStudentIds.has(s.studentId)) {
            corrAbsentStudentIds.delete(s.studentId);
          } else {
            corrAbsentStudentIds.add(s.studentId);
          }
          renderCorrectionChips();
        };

        chip.innerHTML = `
          <div class="chip-left">
            <span class="chip-roll font-mono">${s.rollNo}</span>
            <span class="chip-name" style="font-size: 12px;">${s.name}</span>
          </div>
          <span class="chip-badge ${isAbsent ? 'badge-absent' : 'badge-present'}" style="font-size: 10px;">
            ${isAbsent ? '❌ Absent' : '✅ Present'}
          </span>
        `;
        grid.appendChild(chip);
      });

      const badge = document.getElementById('corr-summary-badge');
      if (badge) {
        badge.textContent = `${currentCohort.length - corrAbsentStudentIds.size} Present, ${corrAbsentStudentIds.size} Absent`;
      }
    }

    function closeCorrectionModal() {
      const modal = document.getElementById('correction-modal');
      if (modal) modal.style.display = 'none';
      selectedSessionForCorrection = null;
    }

    function onReasonInput(textarea) {
      const len = textarea.value.trim().length;
      const counter = document.getElementById('corr-reason-counter');
      const error = document.getElementById('corr-reason-error');
      if (counter) counter.textContent = `${len} / 10 characters minimum`;
      if (error) {
        error.textContent = len < 10 ? '(Reason is mandatory and must be >= 10 chars)' : '';
      }
    }

    async function submitAttendanceCorrection() {
      if (!selectedSessionForCorrection) return;

      const reason = document.getElementById('corr-reason-input').value.trim();
      if (reason.length < 10) {
        alert('⚠️ Justification reason must be at least 10 characters explaining why the attendance was adjusted.');
        return;
      }

      const topicCovered = document.getElementById('corr-topic-input').value.trim();
      const payload = {
        correctionReason: reason,
        topicCovered,
        updatedAbsentStudentIds: Array.from(corrAbsentStudentIds)
      };

      const token = currentUserSession?.accessToken;
      const headers = { 'Content-Type': 'application/json' };
      if (token) headers['Authorization'] = 'Bearer ' + token;

      try {
        const res = await fetch(`/api/v1/faculty/attendance/${selectedSessionForCorrection.id}/correct`, {
          method: 'PUT',
          headers,
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (data.success) {
          alert('✅ Attendance corrected successfully with cryptographic audit event logged.');
          closeCorrectionModal();
          loadFacultySessions();
          return;
        }
      } catch (e) {}

      // Mock update
      selectedSessionForCorrection.absentStudentIds = Array.from(corrAbsentStudentIds);
      selectedSessionForCorrection.absentCount = corrAbsentStudentIds.size;
      selectedSessionForCorrection.presentCount = selectedSessionForCorrection.totalStudents - corrAbsentStudentIds.size;
      if (topicCovered) selectedSessionForCorrection.topicCovered = topicCovered;
      alert('✅ Attendance corrected successfully with cryptographic audit event logged.');
      closeCorrectionModal();
      loadFacultySessions();
    }

    function renderDefaultersTable() {
      const tbody = document.getElementById('defaulter-table-body');
      const dateEl = document.getElementById('defaulter-notice-date');
      if (dateEl) dateEl.textContent = new Date().toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' });
      if (!tbody) return;

      const defaulters = [
        { rollNo: '2024CS09', name: 'Bhoomit Fatnani', total: 45, attended: 31, pct: 68.8, shortfall: 3, status: 'DEFAULTER' },
        { rollNo: '2024CS20', name: 'Parth Khismatrao', total: 45, attended: 32, pct: 71.1, shortfall: 2, status: 'DEFAULTER' },
        { rollNo: '2024CS30', name: 'Vinay Motwani', total: 45, attended: 33, pct: 73.3, shortfall: 1, status: 'DEFAULTER' }
      ];

      tbody.innerHTML = '';
      defaulters.forEach(d => {
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td class="font-mono" style="font-weight: 700;">${d.rollNo}</td>
          <td>${d.name}</td>
          <td class="font-mono">${d.total}</td>
          <td class="font-mono">${d.attended}</td>
          <td class="font-mono" style="color: var(--state-risk); font-weight: 700;">${d.pct}%</td>
          <td class="font-mono">${d.shortfall} Lectures</td>
          <td><span style="background: rgba(214, 69, 69, 0.15); color: var(--state-risk); padding: 2px 8px; border-radius: 4px; font-weight: 700; font-size: 11px;">CRITICAL</span></td>
        `;
        tbody.appendChild(tr);
      });
    }

    // --- Admin Roster Import Functions ---
    function previewRosterCSV() {
      const panel = document.getElementById('roster-preview-panel');
      if (panel) panel.style.display = 'flex';
    }

    function commitRosterImport() {
      alert('✅ Student roster committed: 2 new students created, 1 updated in PostgreSQL database.');
      const panel = document.getElementById('roster-preview-panel');
      if (panel) panel.style.display = 'none';
    }

    function toggleLogDetail(logId) {
      const el = document.getElementById(logId);
      if (el) el.style.display = el.style.display === 'none' ? 'block' : 'none';
    }

    function refreshAdminLogs() {
      fetch('/api/v1/admin/sync/logs')
        .then(res => res.json())
        .then(data => {
          if (data.success) {
            alert('🔄 Admin audit log refreshed with latest classroom marking events.');
          }
        }).catch(() => {});
    }

    // --- M6 Interactive Helper Functions ---
    function filterHistoryTable() {
      const subjectVal = document.getElementById('history-filter-subject').value;
      const statusVal = document.getElementById('history-filter-status').value;
      const searchVal = document.getElementById('history-search-input').value.toLowerCase().trim();

      const rows = document.querySelectorAll('#history-rollcall-stack .roll-call-row');
      rows.forEach(row => {
        const rowSubject = row.getAttribute('data-subject');
        const rowStatus = row.getAttribute('data-status');
        const rowText = row.getAttribute('data-text') || '';

        const matchSubject = subjectVal === 'all' || rowSubject === subjectVal;
        const matchStatus = statusVal === 'all' || rowStatus === statusVal;
        const matchSearch = !searchVal || rowText.toLowerCase().includes(searchVal);

        row.style.display = (matchSubject && matchStatus && matchSearch) ? 'flex' : 'none';
      });
    }

    function exportHistoryCSV() {
      const rows = document.querySelectorAll('#history-rollcall-stack .roll-call-row');
      let csvContent = 'Date,Subject,Status,Details\n';

      rows.forEach(row => {
        if (row.style.display !== 'none') {
          const date = row.querySelector('.rc-date').textContent.trim();
          const subject = row.querySelector('.rc-subject').textContent.trim();
          const status = row.querySelector('.rc-status span').textContent.trim();
          const detail = row.querySelector('.rc-detail').textContent.trim().replace(/,/g, ' -');
          csvContent += `"${date}","${subject}","${status}","${detail}"\n`;
        }
      });

      const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.setAttribute('href', url);
      link.setAttribute('download', `openattend-history-${new Date().toISOString().slice(0,10)}.csv`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    }

    function updatePredictorView(subjectCode) {
      const centerpiece = document.getElementById('predictor-centerpiece');
      const textEl = document.getElementById('predictor-sentence-text');
      const breakdownEl = document.getElementById('predictor-formula-breakdown');

      const data = {
        'overall': { present: 101, total: 126, threshold: 0.75, status: 'SAFE', skips: 8, must: 0 },
        'CS401': { present: 36, total: 42, threshold: 0.75, status: 'SAFE', skips: 6, must: 0 },
        'CS402': { present: 36, total: 44, threshold: 0.75, status: 'SAFE', skips: 4, must: 0 },
        'CS403': { present: 29, total: 40, threshold: 0.75, status: 'RISK', skips: 0, must: 4 }
      };

      const sel = data[subjectCode] || data['overall'];

      if (sel.status === 'SAFE') {
        centerpiece.style.background = 'var(--accent-dim)';
        centerpiece.style.borderColor = 'var(--accent)';
        textEl.innerHTML = `You can miss <span class="predictor-num font-mono" style="font-size: 1.75rem; color: var(--state-safe);">${sel.skips}</span> more consecutive lectures while keeping attendance above <strong>75%</strong>.`;
        breakdownEl.innerHTML = `Formula: Safe Skips = floor((P - (threshold × T)) / threshold)<br>Inputs: P = ${sel.present} present, T = ${sel.total} total, threshold = 0.75<br>Calculation: (${sel.present} - (0.75 × ${sel.total})) / 0.75 = ${sel.skips} skips remaining`;
      } else {
        centerpiece.style.background = 'rgba(214, 69, 69, 0.12)';
        centerpiece.style.borderColor = 'var(--state-risk)';
        textEl.innerHTML = `You must attend <span class="predictor-num font-mono" style="font-size: 1.75rem; color: var(--state-risk);">${sel.must}</span> consecutive lectures to reach <strong>75%</strong> threshold.`;
        breakdownEl.innerHTML = `Formula: Must Attend = ceil(((threshold × T) - P) / (1 - threshold))<br>Inputs: P = ${sel.present} present, T = ${sel.total} total, threshold = 0.75<br>Calculation: ((0.75 × ${sel.total}) - ${sel.present}) / (1 - 0.75) = ${sel.must} lectures required`;
      }
    }

    function markAllNotificationsRead() {
      fetch('/api/v1/notifications/read-all', { method: 'PATCH' }).catch(() => {});
      document.querySelectorAll('#pane-notifications .roll-call-row').forEach(row => {
        row.style.opacity = '0.65';
      });
    }

    let currentAuthRole = 'STUDENT';
    let currentUserSession = null;

    function switchAuthTab(role) {
      currentAuthRole = role;
      document.getElementById('auth-tab-student')?.classList.toggle('active', role === 'STUDENT');
      document.getElementById('auth-tab-faculty')?.classList.toggle('active', role === 'FACULTY');
      document.getElementById('auth-tab-classteacher')?.classList.toggle('active', role === 'CLASS_TEACHER');
      document.getElementById('auth-tab-admin')?.classList.toggle('active', role === 'ADMIN');
      
      const placeholders = {
        'STUDENT': 'student@ves.ac.in',
        'FACULTY': 'faculty@ves.ac.in',
        'CLASS_TEACHER': 'classteacher@ves.ac.in',
        'ADMIN': 'admin@ves.ac.in'
      };
      document.getElementById('auth-email-input').placeholder = placeholders[role] || 'student@ves.ac.in';
      hideAuthError();
    }

    function fillQuickDemo(role) {
      switchAuthTab(role);
      const emailMap = {
        'STUDENT': 'student@ves.ac.in',
        'FACULTY': 'faculty@ves.ac.in',
        'CLASS_TEACHER': 'classteacher@ves.ac.in',
        'ADMIN': 'admin@ves.ac.in'
      };
      const email = emailMap[role] || 'student@ves.ac.in';
      document.getElementById('auth-email-input').value = email;
      // Per Doubt C: password = email
      document.getElementById('auth-password-input').value = email;
      hideAuthError();
      submitAuthLogin();
    }

    function showAuthError(msg) {
      const alert = document.getElementById('auth-error-alert');
      document.getElementById('auth-error-text').textContent = msg;
      alert.style.display = 'flex';
    }

    function hideAuthError() {
      document.getElementById('auth-error-alert').style.display = 'none';
    }

    async function submitAuthLogin(e) {
      if (e) e.preventDefault();
      hideAuthError();

      const email = document.getElementById('auth-email-input').value.trim();
      const password = document.getElementById('auth-password-input').value;
      const submitBtn = document.getElementById('auth-submit-btn');

      if (!email.toLowerCase().endsWith('@ves.ac.in')) {
        showAuthError('Only official @ves.ac.in institutional email addresses are permitted.');
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = 'Authenticating…';

      const warmupTimer = setTimeout(() => {
        if (submitBtn.disabled) {
          submitBtn.textContent = 'Connecting to OpenAttend server…';
        }
      }, 3000);

      const apiBase = (window.location.protocol === 'file:' || !window.location.host) ? 'https://openattend-vesit.onrender.com' : '';

      try {
        const res = await fetch(apiBase + '/api/v1/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password })
        });

        const data = await res.json();
        if (!data.success) {
          showAuthError(data.error || 'Authentication failed');
          clearTimeout(warmupTimer);
          submitBtn.disabled = false;
          submitBtn.textContent = 'Sign In to OpenAttend ERP →';
          return;
        }

        // Save session locally
        currentUserSession = data.session;
        localStorage.setItem('openattend_session', JSON.stringify(data.session));

        applyUserSession(data.session);
        document.getElementById('auth-modal').classList.add('hidden');

      } catch (err) {
        // Network fallback: handle local demo authentication if backend server is unreachable
        const cleanEmail = email.toLowerCase();
        if (cleanEmail === 'faculty@ves.ac.in' || cleanEmail.includes('faculty') || cleanEmail.includes('prof')) {
          const mockSession = {
            id: 'usr_fac_01',
            email: 'faculty@ves.ac.in',
            name: 'Prof. Amit Rao',
            role: 'FACULTY',
            rollNo: 'FAC-01',
            division: 'D12B',
            batch: null,
            accessToken: 'at_demo_faculty_' + Date.now()
          };
          currentUserSession = mockSession;
          localStorage.setItem('openattend_session', JSON.stringify(mockSession));
          applyUserSession(mockSession);
          document.getElementById('auth-modal').classList.add('hidden');
        } else if (cleanEmail === 'classteacher@ves.ac.in' || cleanEmail.includes('teacher')) {
          const mockSession = {
            id: 'usr_ct_01',
            email: 'classteacher@ves.ac.in',
            name: 'Prof. Sneha Sharma',
            role: 'CLASS_TEACHER',
            rollNo: 'CT-01',
            division: 'D12B',
            batch: null,
            accessToken: 'at_demo_ct_' + Date.now()
          };
          currentUserSession = mockSession;
          localStorage.setItem('openattend_session', JSON.stringify(mockSession));
          applyUserSession(mockSession);
          document.getElementById('auth-modal').classList.add('hidden');
        } else if (cleanEmail === 'admin@ves.ac.in' || cleanEmail.includes('admin')) {
          const mockSession = {
            id: 'usr_admin_1',
            email: 'admin@ves.ac.in',
            name: 'Prof. Admin User',
            role: 'ADMIN',
            rollNo: 'ADM-01',
            accessToken: 'at_demo_admin_' + Date.now()
          };
          currentUserSession = mockSession;
          localStorage.setItem('openattend_session', JSON.stringify(mockSession));
          applyUserSession(mockSession);
          document.getElementById('auth-modal').classList.add('hidden');
        } else {
          const mockSession = {
            id: 'usr_student_1',
            email: cleanEmail,
            name: 'Vedant Gharat',
            role: 'STUDENT',
            rollNo: '2024CS01',
            division: 'D12B',
            batch: 'B1',
            accessToken: 'at_demo_student_' + Date.now()
          };
          currentUserSession = mockSession;
          localStorage.setItem('openattend_session', JSON.stringify(mockSession));
          applyUserSession(mockSession);
          document.getElementById('auth-modal').classList.add('hidden');
        }
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Sign In to OpenAttend ERP →';
      }
    }

    function applyUserSession(session) {
      currentUserSession = session;
      const initials = session.name ? session.name.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase() : 'US';
      
      document.getElementById('user-avatar-initials').textContent = initials;
      document.getElementById('user-name-display').textContent = session.name || session.email;
      document.getElementById('user-role-display').textContent = `${session.role} • ${session.rollNo || ''}`;
      document.getElementById('user-profile-bar').style.display = 'flex';

      toggleRole(session.role);
    }

    function handleLogout() {
      if (currentUserSession && currentUserSession.accessToken) {
        fetch('/api/v1/auth/logout', {
          method: 'POST',
          headers: { 'Authorization': 'Bearer ' + currentUserSession.accessToken }
        }).catch(() => {});
      }

      currentUserSession = null;
      localStorage.removeItem('openattend_session');

      document.getElementById('user-profile-bar').style.display = 'none';
      document.getElementById('auth-email-input').value = '';
      document.getElementById('auth-password-input').value = '';
      hideAuthError();
      document.getElementById('auth-modal').classList.remove('hidden');
    }

    // Auto-login check on page load
    window.addEventListener('DOMContentLoaded', () => {
      const saved = localStorage.getItem('openattend_session');
      if (saved) {
        try {
          const session = JSON.parse(saved);
          if (session && session.accessToken) {
            applyUserSession(session);
            document.getElementById('auth-modal').classList.add('hidden');
            return;
          }
        } catch (e) {}
      }
      // Register PWA Service Worker
      if ('serviceWorker' in navigator && window.location.protocol !== 'file:') {
        navigator.serviceWorker.register('/sw.js').then(() => {
          console.log('OpenAttend PWA Service Worker Registered');
        }).catch(() => {});
      }
    });
  </script>

</body>
</html>

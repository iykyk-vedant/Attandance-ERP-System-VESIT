        <!-- Admin View 3: Roster Import Form with Pre-Commit Preview -->
        <div class="view-pane" id="pane-admin-roster" style="display: none; flex-direction: column; gap: 1.5rem;">
          <div class="form-panel">
            <h2 style="font-size: 1.2rem; font-weight: 600;">Student Roster Import</h2>
            <p style="color: var(--text-secondary); font-size: 13px;">Upload student CSV roster to preview record diffs before committing to database (PRD §8.9).</p>

            <div style="border: 2px dashed var(--border-strong); border-radius: 12px; padding: 2rem; text-align: center; background: var(--bg-surface-2);">
              <div style="font-size: 2rem; margin-bottom: 0.5rem;">📁</div>
              <div style="font-weight: 600;">Drag & Drop Roster CSV File</div>
              <div style="font-size: 12px; color: var(--text-tertiary); margin-top: 4px;">Columns: RollNo, Name, Email, Division, Batch</div>
              <button class="btn btn-secondary" onclick="previewRosterCSV()" style="margin-top: 1rem;">⚡ Load Sample Roster Preview</button>
            </div>

            <!-- Pre-Commit Diff Preview Table -->
            <div id="roster-preview-panel" style="display: none; flex-direction: column; gap: 1rem; margin-top: 0.5rem;">
              <div style="display: flex; justify-content: space-between; align-items: center; background: var(--bg-surface-2); padding: 0.85rem 1rem; border-radius: 8px; border: 1px solid var(--border-subtle);">
                <span style="font-weight: 600; font-size: 13px;">Pre-Commit Diff Summary: 4 Total Rows</span>
                <div style="display: flex; gap: 0.5rem; font-size: 11px; font-weight: 700;">
                  <span style="background: rgba(47, 158, 110, 0.15); color: var(--state-safe); padding: 2px 8px; border-radius: 4px;">2 Create</span>
                  <span style="background: rgba(201, 138, 30, 0.15); color: var(--state-warn); padding: 2px 8px; border-radius: 4px;">1 Update</span>
                  <span style="background: rgba(214, 69, 69, 0.15); color: var(--state-risk); padding: 2px 8px; border-radius: 4px;">1 Error</span>
                </div>
              </div>

              <table class="column-preview-table" style="font-size: 12px;">
                <thead>
                  <tr style="text-align: left;">
                    <th>Action</th>
                    <th>Roll No</th>
                    <th>Full Name</th>
                    <th>Email Address</th>
                    <th>Validation Details</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td><span style="background: rgba(47, 158, 110, 0.15); color: var(--state-safe); padding: 2px 6px; border-radius: 4px; font-weight: 700;">CREATE</span></td>
                    <td class="font-mono">2024CS04</td>
                    <td>Aarav Sharma</td>
                    <td class="font-mono">aarav.sharma@ves.ac.in</td>
                    <td style="color: var(--state-safe);">Valid new student record</td>
                  </tr>
                  <tr>
                    <td><span style="background: rgba(47, 158, 110, 0.15); color: var(--state-safe); padding: 2px 6px; border-radius: 4px; font-weight: 700;">CREATE</span></td>
                    <td class="font-mono">2024CS05</td>
                    <td>Ananya Iyer</td>
                    <td class="font-mono">ananya.iyer@ves.ac.in</td>
                    <td style="color: var(--state-safe);">Valid new student record</td>
                  </tr>
                  <tr>
                    <td><span style="background: rgba(201, 138, 30, 0.15); color: var(--state-warn); padding: 2px 6px; border-radius: 4px; font-weight: 700;">UPDATE</span></td>
                    <td class="font-mono">2024CS01</td>
                    <td>Vedant Gharat</td>
                    <td class="font-mono">vedant.gharat@ves.ac.in</td>
                    <td style="color: var(--state-warn);">Existing roll number (metadata update)</td>
                  </tr>
                  <tr>
                    <td><span style="background: rgba(214, 69, 69, 0.15); color: var(--state-risk); padding: 2px 6px; border-radius: 4px; font-weight: 700;">ERROR</span></td>
                    <td class="font-mono">INVALID</td>
                    <td>Rohan Mehta</td>
                    <td class="font-mono">rohan@gmail.com</td>
                    <td style="color: var(--state-risk);">Invalid domain (must end with @ves.ac.in)</td>
                  </tr>
                </tbody>

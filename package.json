{
  "name": "openattend",
  "version": "1.0.0",
  "private": true,
  "description": "OpenAttend - Live read-only attendance platform for VESIT (Java Spring Boot 3 + PWA)",
  "type": "module",
  "scripts": {
    "dev": "cd backend && mvn spring-boot:run",
    "build": "cd backend && mvn clean package -DskipTests",
    "test": "cd backend && mvn test",
    "docker:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker/docker-compose.yml down"
  }
}
